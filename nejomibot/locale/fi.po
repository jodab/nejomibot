msgstr "✅ Uusi profiilikuva: {size} {format}, {bytes}."

#: nejomibot/profile.py
msgid "✅ Avatar removed."
msgstr "✅ Profiilikuva poistettu."

#: nejomibot/profile.py
msgid "That isn't a picture."
msgstr "Se ei ole kuva."

#: nejomibot/profile.py
#, python-brace-format
msgid "That's {count} picture: send just one with /avatar."
msgid_plural "That's {count} pictures: send just one with /avatar."
msgstr[0] "Siinä on {count} kuva: lähetä vain yksi komennolla /profiilikuva."
msgstr[1] "Siinä on {count} kuvaa: lähetä vain yksi komennolla /profiilikuva."

#: nejomibot/profile.py
msgid "No username"
msgstr "Ei käyttäjänimeä"

