msgstr "Säiliö"

#: nejomibot/status.py
msgid "Host"
msgstr "Isäntä"

#: nejomibot/timers.py
#, python-brace-format
msgid ""
"<when> is a time (08:00, or 08:00,18:30), days and a time (mon-fri 07:30, "
"sat,sun 10:00), a date and a time for once ({date} 15:00, tomorrow 08:00), "
"or every 2h or 30m"
msgstr ""
"<milloin> on kellonaika (08:00 tai 08:00,18:30), päivät ja kellonaika (ma-pe "
"07:30, la,su 10:00), päivämäärä ja kellonaika kertaluonteisesti ({date} "
"15:00, huomenna 08:00) tai joka 2h tai 30m"

#: nejomibot/timers.py
msgid "/chats: where timers can post, numbered"
msgstr "/chats: minne ajastimet voivat julkaista, numeroituina"

#: nejomibot/timers.py
msgid "/timers: the timers"
msgstr "/timers: ajastimet"

#: nejomibot/timers.py
msgid "/timer add <when> [<chats>] <commands>: a new one, e.g."
msgstr "/timer lisää <milloin> [<keskustelut>] <komennot>: uusi, esimerkiksi"

#: nejomibot/timers.py
msgid "/timer add mon-fri 07:30 1,2 /weather; /photo"
msgstr "/timer lisää ma-pe 07:30 1,2 /sää; /kuva"

#: nejomibot/timers.py
msgid "The chats are numbers from /chats; without them, it posts to you."
msgstr ""
"Keskustelut ovat numeroita listasta /chats; ilman niitä ajastin julkaisee "
"sinulle."

#: nejomibot/timers.py
msgid "/timer remove <n>, /timer run <n>: remove one, or run it now"
msgstr "/timer poista <n>, /timer suorita <n>: poista yksi tai suorita se nyt"

#: nejomibot/timers.py
#, python-brace-format
msgid "{when_help}, in {zone} time."
msgstr "{when_help}, aikavyöhykkeen {zone} mukaan."

#: nejomibot/timers.py
msgid "Every how long? Like every 30m, every 2h or every 1h30m."
msgstr "Kuinka usein? Kuten joka 30m, joka 2h tai joka 1h30m."

#: nejomibot/timers.py
#, python-brace-format
msgid "Not more often than every {every}."
msgstr "Ei useammin kuin {every} välein."

#: nejomibot/timers.py
#, python-brace-format
msgid "There's no such day as {day}."
msgstr "Päivää {day} ei ole."

#: nejomibot/timers.py
msgid "At what time?"
msgstr "Mihin aikaan?"

#: nejomibot/timers.py
msgid "A timer on a date runs once: give it one time, and no days."
msgstr ""
"Päivämäärälle asetettu ajastin suoritetaan kerran: anna sille yksi "
"kellonaika eikä päiviä."

#: nejomibot/timers.py
#, python-brace-format
msgid "Timers, specials and /run can't run {command}."
msgstr ""
"Ajastimet, erikoiskomennot ja /suorita eivät voi suorittaa komentoa "
"{command}."

#: nejomibot/timers.py
msgid "A timer's commands can't have a |: the timers file uses it."
msgstr ""
"Ajastimen komennoissa ei voi olla merkkiä |: ajastintiedosto käyttää sitä."

#: nejomibot/timers.py
#, python-brace-format
msgid "{command} isn't a command the bot knows."
msgstr "{command} ei ole botin tuntema komento."

#: nejomibot/timers.py
#, python-brace-format
msgid "Commands start with . or /, unlike {command}."
msgstr "Komennot alkavat merkillä . tai /, toisin kuin {command}."

#: nejomibot/timers.py
#, python-brace-format
msgid "At most {count} commands at once."
msgstr "Enintään {count} komentoa kerralla."

#: nejomibot/timers.py
msgid "Which commands?"
msgstr "Mitkä komennot?"

#: nejomibot/timers.py
msgid "For /timer add, e.g. /timer add 08:00 1,2 /weather; /photo"
msgstr "Komentoon /timer lisää, esimerkiksi /timer lisää 08:00 1,2 /sää; /kuva"

#: nejomibot/timers.py
msgid "Timers can post to:"
msgstr "Ajastimet voivat julkaista kohteisiin:"

#: nejomibot/timers.py
#, python-brace-format
msgid "Next: {when}"
msgstr "Seuraava: {when}"

#: nejomibot/timers.py
msgid "No timers yet."
msgstr "Ei vielä ajastimia."

#: nejomibot/timers.py
#, python-brace-format
msgid "There's no chat {n}: /chats numbers them."
msgstr "Keskustelua {n} ei ole: /chats numeroi ne."

#: nejomibot/timers.py
#, python-brace-format
msgid "There are {count} timers already: remove one first."
msgstr "Ajastimia on jo {count}: poista ensin yksi."

#: nejomibot/timers.py
msgid "Which timer? Give its number, as /timers shows."
msgstr "Mikä ajastin? Anna sen numero, kuten /timers näyttää."

#: nejomibot/timers.py
#, python-brace-format
msgid "No timer #{n}."
msgstr "Ei ajastinta #{n}."

#: nejomibot/timers.py
#, python-brace-format
msgid "▶️ Ran timer #{n}"
msgstr "▶️ Ajastin #{n} suoritettu"

#: nejomibot/today.py
msgid "Which day? Such as 10-25, 2026-10-25 or tomorrow; none for today."
msgstr ""
"Mikä päivä? Kuten 10-25, 2026-10-25 tai huomenna; ei mitään tälle päivälle."

#: nejomibot/today.py
msgid "Nothing special."
msgstr "Ei mitään erityistä."

#: nejomibot/today.py
#, python-brace-format
msgid "👁️ {command} on {day}"
msgstr "👁️ {command}: {day}"

#: nejomibot/today.py
msgid "In a direct chat"
msgstr "Yksityiskeskustelussa"

