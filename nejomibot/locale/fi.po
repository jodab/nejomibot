#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin lisää <kuka> [<kieli>]: tee jostakusta ylläpitäjä, hänen numerollaan "
"listassa /yhteystiedot, puhelinnumerolla, Signal-tunnuksella tai nimellä, ja "
"lähetä hänelle tervetulotoivotus; kielen kanssa, esimerkiksi fi, botti "
"käyttää sitä hänen kanssaan"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin poista <n>: ei enää, hänen numerollaan listassa /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr "Vain asetusten ylläpitäjät lisäävät ja poistavat ylläpitäjiä."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Ylläpitäjät ({count}):"

#: nejomibot/admins.py
msgid "in the config"
msgstr "asetuksissa"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin lisää <kuka> lisää yhden, /admin poista <n> poistaa yhden; vain "
"asetusten ylläpitäjät voivat tehdä sen."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} on ryhmä: ylläpitäjät ovat henkilöitä."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "Tervetuloa!"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} on tehnyt sinusta tämän botin ylläpitäjän."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Olet nyt tämän botin ylläpitäjä."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all. A few to start with:"
msgstr ""
"Täällä, yksityiskeskustelussa botin kanssa, voit käyttää kaikkia komentoja: "
"{help} luettelee ne kaikki. Muutama alkuun:"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Kiitos, että autat pitämään huolta botista."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "Tervetulotoivotus lähti hänelle, kielellä {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr "Tervetulotoivotus hänelle, kielellä {language}, odottaa lähetystä."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "Tervetulotoivotusta ei voitu lähettää hänelle."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Se on botti itse."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} on jo ylläpitäjä asetuksissa."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"Botti ei vielä tiedä Signal-tunnusta, jolla {name} tallennetaan "
"ylläpitäjäksi: kun hän on kirjoittanut botille, se tietää sen."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} on jo ylläpitäjä."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "Lista on täynnä: enintään {count}."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr "👑 {name} on nyt ylläpitäjä ja voi käyttää kaikkia komentoja."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "Botti käyttää hänen kanssaan tästä lähtien kieltä: {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr "{who} on ylläpitäjä asetuksissa, eikä mikään komento muuta sitä."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} ei ole enää ylläpitäjä."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr "Hän on listassa /sallitut, joten hän voi yhä käyttää arkikomentoja."

#: nejomibot/albums.py nejomibot/status.py
#, python-brace-format
msgid "{count} photo"
msgid_plural "{count} photos"
msgstr[0] "{count} kuva"
msgstr[1] "{count} kuvaa"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} albumi"
msgstr[1] "📚 {count} albumia"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Ei albumeja: jokainen kuva-arkiston kansio on albumi."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} kuva ilman albumia"
msgstr[1] "📷 {count} kuvaa ilman albumia"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <albumi>: albumi. /album <albumi> 2019-06-15: syntymäpäivä, josta "
"kuvatekstit laskevat iän; /album <albumi> -: ei syntymäpäivää. /album "
"<albumi> oikopolut /alice: muita nimiä komennolle /kuva <albumi>; /album "
"<albumi> oikopolut -: ei yhtään. /albumit luettelee albumit."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Syntynyt {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Ei syntymäpäivää, joten kuvateksteissä ei näy ikää"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Oikopolut: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Ei oikopolkuja"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr "✅ {album}: syntynyt {day}, joten kuvateksteissä näkyy ikä."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "Albumilla {album} ei ole syntymäpäivää."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr "✅ {album}: ei syntymäpäivää, joten kuvateksteissä ei näy ikää."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} on jo oikopolku kohteelle {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "Kohteella {album} ei ole oikopolkuja."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: ei oikopolkuja."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Albumilla voi olla enintään {count} oikopolkua."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Oikopolut komennolle /kuva {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} ei ole päivämäärä muotoa 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Lähetä /salli ja kuka: puhelinnumero, Signal-tunnus tai ryhmätunnus, "
"sellaisen ryhmän nimi, jossa botti on, tai joku listasta /yhteystiedot, "
"numerolla tai nimellä."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Lähetä /estä ja kuka: numero listassa /sallitut, puhelinnumero, Signal-"
"tunnus tai ryhmätunnus tai nimi."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr "{who} on ylläpitäjä ja voi käyttää kaikkia komentoja: katso /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(botti ei ole siinä)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Arkikomentoja saavat käyttää ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Ylläpitäjät voivat käyttää kaikkia komentoja: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/salli <kuka> lisää yhden, /estä <n> poistaa yhden."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Ei puhelinnumeroa tai tunnusta: {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Minkään henkilön tai ryhmän nimi ei ole {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} sopii useaan ({count}), anna tunnus: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} saa jo käyttää arkikomentoja."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} saa nyt käyttää arkikomentoja."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Kaikki ryhmässä {name} saavat nyt käyttää siellä arkikomentoja."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Botti ei ole ryhmässä: se vastaa siellä, kun se on lisätty."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Listassa {command} ei ole numeroa {n}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} ei ole listassa {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} sopii useaan ({count}) listassa {command}: anna numero."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Ajastin {timers} julkaisee siellä yhä: katso /timers."
msgstr[1] "Ajastimet {timers} julkaisevat siellä yhä: katso /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Kukaan ryhmässä {name} ei saa enää käyttää siellä arkikomentoja."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} ei saa enää käyttää arkikomentoja."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Hän on ylläpitäjä, joten hän voi yhä käyttää niitä."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Hyvää nimipäivää, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} täyttää tänään {age}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Hyvää syntymäpäivää, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "kaikki ryhmät"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Ei syntymäpäiviä täällä."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} syntymäpäivä"
msgstr[1] "🎂 {count} syntymäpäivää"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Ei nimipäiviä täällä."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} nimipäivä"
msgstr[1] "🌸 {count} nimipäivää"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(täyttää {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr "Syntymäpäivät ja nimipäivät näkyvät ryhmissä niiden jäsenille."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr ""
"/syntymäpäivä lisää <päivämäärä> [<keskustelut>] <kuka>: syntymäpäivä, "
"esimerkiksi"

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr "/syntymäpäivä lisää 1990-03-14 Alice: yhteystieto, hänen ryhmissään"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/syntymäpäivä lisää 03-14 1,2 Mummo: joku, joka ei ole Signalissa, "
"keskusteluissa 1 ja 2 listasta /chats; ilman niitä kaikissa ryhmissä"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr ""
"/syntymäpäivä poista <n>: poista yksi, sen numerolla listassa /syntymäpäivät"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr ""
"/nimipäivä lisää <päivämäärä> [<keskustelut>] <kuka>: nimipäivä, esimerkiksi"

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr "/nimipäivä lisää 08-08 Alice: yhteystieto, hänen ryhmissään"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/nimipäivä lisää 08-08 1,2 Mummo: joku, joka ei ole Signalissa, "
"keskusteluissa 1 ja 2 listasta /chats; ilman niitä kaikissa ryhmissä"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/nimipäivä poista <n>: poista yksi, sen numerolla listassa /nimipäivät"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Ketään nimeltä {who} ei ole listassa /yhteystiedot."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Tallenna ensin {who} yhteystiedoksi nimellä, joka näytetään: /yhteystiedot "
"lisää {who} <nimi>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} ei ole päivä: anna se muodossa 1990-03-14 tai 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "Nimipäivällä ei ole vuotta: anna se muodossa 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} on vasta tulossa."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Nimessä voi olla enintään {count} merkkiä."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} ei ole ryhmä: syntymäpäivät ja nimipäivät näkyvät vain ryhmissä."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} on jo merkitty sille päivälle."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Syntymäpäiviä ja nimipäiviä on jo {count}: poista ensin yksi."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Lisätty: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Muutettu: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 Ryhmissä, joissa {name} on"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 Kaikissa ryhmissä: minkään yhteystiedon nimi ei ole {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Vain joihinkin ryhmiin: lisää se uudelleen niiden numeroilla listasta /"
"chats: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Mikä? Anna sen numero, kuten {command} näyttää."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Mitkä? Lähetä ensin {command} nähdäksesi numerot."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "Numeroa {n} ei enää ole: poistettu tai muutettu sen jälkeen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Poistettu: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Botti vastaa kultakin henkilöltä enintään {count} komentoon {period} "
"aikana. Se vastaa sinulle taas {wait} kuluttua."
msgstr[1] ""
"⏳ Botti vastaa kultakin henkilöltä enintään {count} komentoon {period} "
"aikana. Se vastaa sinulle taas {wait} kuluttua."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "Oikopolussa ei voi olla merkkiä | tai ;."

#: nejomibot/commands.py
#, python-brace-format
