"Send /msg <chats> <text>, e.g. /msg 1,2 Hello! The chats are numbers from /"
"chats."
msgstr ""
"Lähetä /lähetä <keskustelut> <teksti>, esimerkiksi /lähetä 1,2 Hei! "
"Keskustelut ovat numeroita listasta /chats."

#: nejomibot/relay.py
msgid ""
"Send /run <chats> <commands>, e.g. /run 1 /weather; /photo. The chats are "
"numbers from /chats."
msgstr ""
"Lähetä /suorita <keskustelut> <komennot>, esimerkiksi /suorita 1 /sää; /"
"kuva. Keskustelut ovat numeroita listasta /chats."

#: nejomibot/relay.py
#, python-brace-format
msgid "⏳ Not sent yet to {chats}: tried again for {hours} hours."
msgstr ""
"⏳ Ei vielä lähetetty: {chats}. Yritetään uudelleen {hours} tunnin ajan."

#: nejomibot/relay.py
#, python-brace-format
msgid "⚠️ May not have reached {chats}."
msgstr "⚠️ Ei ehkä mennyt perille: {chats}."

#: nejomibot/relay.py
#, python-brace-format
