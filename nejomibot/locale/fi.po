msgstr "Ei profiilikuvaa"

#: nejomibot/profile.py
msgid "Change them with /name, /about, /avatar and /username."
msgstr ""
"Muuta niitä komennoilla /nimi, /tietoja, /profiilikuva ja /käyttäjänimi."

#: nejomibot/publicip.py
msgid "not announced"
msgstr "ei ilmoitettu"

#: nejomibot/publicip.py
#, python-brace-format
