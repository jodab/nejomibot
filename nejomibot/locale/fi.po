#: nejomibot/specials.py
msgid "Give it a name: a word that starts with . or /, like /morning."
msgstr "Anna sille nimi: sana, joka alkaa merkillä . tai /, kuten /aamu."

#: nejomibot/specials.py
#, python-brace-format
msgid "{command} is a special of yours, and specials can't run each other."
msgstr ""
"{command} on yksi erikoiskomennoistasi, eivätkä erikoiskomennot voi "
"suorittaa toisiaan."

#: nejomibot/specials.py
msgid "What should it post?"
msgstr "Mitä sen pitäisi julkaista?"

#: nejomibot/specials.py
#, python-brace-format
msgid "A special has at most {count} parts."
msgstr "Erikoiskomennossa voi olla enintään {count} osaa."

#: nejomibot/specials.py
#, python-brace-format
msgid ""
"⚠️ It runs admin commands: {commands}. Everyone allowed who uses it, in a "
"group too, now sees what they show, and has them do what they do; /special "
"admins {name} takes that back."
msgstr ""
"⚠️ Se suorittaa ylläpitäjän komentoja: {commands}. Jokainen sallittu, joka "
"käyttää sitä, myös ryhmässä, näkee nyt, mitä ne näyttävät, ja saa ne "
"tekemään sen, mitä ne tekevät; /special ylläpitäjille {name} peruu sen."

#: nejomibot/specials.py
msgid "/specials: commands of your own, of text and other commands"
msgstr "/specials: omat komennot, tekstistä ja muista komennoista"

#: nejomibot/specials.py
msgid "/special add <name> <parts>: a new one, or a change, e.g."
msgstr "/special lisää <nimi> <osat>: uusi, tai muutos, esimerkiksi"

#: nejomibot/specials.py
msgid "/special add /morning Good morning! /weather"
msgstr "/special lisää /aamu Huomenta! /sää"

#: nejomibot/specials.py
msgid ""
"Parts are separated by ; or line breaks. Text before a command heads its "
"answer, text alone is a message."
msgstr ""
"Osat erotetaan merkillä ; tai rivinvaihdoilla. Komennon edellä oleva teksti "
"on sen vastauksen otsikko, pelkkä teksti on oma viestinsä."

#: nejomibot/specials.py
msgid ""
"A + in place of a ; puts the parts on either side of it in one message, as "
"in /today + /weather."
msgstr ""
"Merkki + merkin ; sijaan kokoaa sen molemmin puolin olevat osat yhteen "
"viestiin, kuten /tänään + /sää."

#: nejomibot/specials.py
msgid "Text keeps the formatting you give it in Signal, such as bold."
msgstr ""
"Teksti säilyttää muotoilun, jonka annat sille Signalissa, kuten lihavoinnin."

#: nejomibot/specials.py
msgid ""
"/special shortcuts <name> <names>: other names for one, such as /special "
"shortcuts /morning /gm; with -, none"
msgstr ""
"/special oikopolut <nimi> <nimet>: muita nimiä yhdelle, kuten /special "
"oikopolut /aamu /hm; merkillä - ei yhtään"

#: nejomibot/specials.py
msgid ""
"/special everyone <name>: everyone allowed may use it, in groups too, and /"
"help lists it; /special admins <name>: the admins alone again"
msgstr ""
"/special kaikille <nimi>: kaikki sallitut saavat käyttää sitä, myös "
"ryhmissä, ja /apu näyttää sen; /special ylläpitäjille <nimi>: taas vain "
"ylläpitäjät"

#: nejomibot/specials.py
msgid "/special remove <name>: remove one"
msgstr "/special poista <nimi>: poista yksi"

#: nejomibot/specials.py
msgid "for everyone"
msgstr "kaikille"

#: nejomibot/specials.py
