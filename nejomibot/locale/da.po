#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin tilføj <hvem> [<sprog>]: gør nogen til admin, via nummeret i /"
"kontakter, telefonnummer, Signal-id eller navn, og send en velkomstbesked; "
"med et sprog, f.eks. da, taler botten det med vedkommende"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin fjern <n>: ikke længere, via nummeret i /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr "Kun admins i konfigurationen tilføjer og fjerner admins."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Admins ({count}):"

#: nejomibot/admins.py
msgid "in the config"
msgstr "i konfigurationen"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin tilføj <hvem> tilføjer én, /admin fjern <n> fjerner én; det kan kun "
"admins i konfigurationen."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} er en gruppe: admins er personer."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "Velkommen!"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} har gjort dig til admin for denne bot."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Du er nu admin for denne bot."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all. A few to start with:"
msgstr ""
"Her, i en direkte chat med botten, må du bruge alle kommandoer: {help} viser "
"dem alle. Et par stykker til at begynde med:"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Tak, fordi du hjælper med at passe på botten."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "En velkomstbesked blev sendt til vedkommende, på {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr ""
"En velkomstbesked til vedkommende, på {language}, venter på at blive sendt."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "Velkomstbeskeden til vedkommende kunne ikke sendes."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Det er botten selv."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} er allerede admin i konfigurationen."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"Botten kender endnu ikke Signal-id'et for {name}, som admins gemmes under: "
"når vedkommende har skrevet til den, gør den."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} er allerede admin."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "Listen er fuld: højst {count}."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr "👑 {name} er nu admin og må bruge alle kommandoer."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "Botten taler fremover {language} med vedkommende."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr "{who} er admin i konfigurationen, hvilket ingen kommando ændrer."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} er ikke længere admin."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr "Vedkommende står i /tilladte og må stadig bruge hverdagskommandoerne."

#: nejomibot/albums.py nejomibot/status.py
#, python-brace-format
msgid "{count} photo"
msgid_plural "{count} photos"
msgstr[0] "{count} billede"
msgstr[1] "{count} billeder"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} album"
msgstr[1] "📚 {count} album"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Ingen album: hver mappe i billedarkivet er et."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} billede uden album"
msgstr[1] "📷 {count} billeder uden album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <album>: albummet. /album <album> 2019-06-15: fødselsdatoen, som "
"billedteksterne regner en alder fra; /album <album> -: ingen. /album <album> "
"genveje /alice: andre navne for /billede <album>; /album <album> genveje -: "
"ingen. /albums viser albummene."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Født {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Ingen fødselsdato, så billedteksterne viser ingen alder"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Genveje: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Ingen genveje"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr "✅ {album}: født {day}, så billedteksterne viser alderen."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} har ingen fødselsdato."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr "✅ {album}: ingen fødselsdato, så billedteksterne viser ingen alder."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} er allerede en genvej for {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} har ingen genveje."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: ingen genveje."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Et album har højst {count} genveje."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Genveje for /billede {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} er ikke en dato som 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Send /tillad og hvem: et telefonnummer, Signal-id eller gruppe-id, navnet på "
"en gruppe, botten er med i, eller nogen i /kontakter, via nummeret der eller "
"navnet."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Send /afvis og hvem: nummeret i /tilladte, telefonnummer, Signal-id eller "
"gruppe-id eller navn."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr "{who} er admin og må bruge alle kommandoer: se /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(botten er ikke med i den)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Hvem der må bruge hverdagskommandoerne ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Admins må bruge alle kommandoer: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/tillad <hvem> tilføjer nogen, /afvis <n> fjerner nogen."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Intet telefonnummer eller id for {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Ingen person og ingen gruppe hedder {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} kan være hvem som helst af {count}, angiv id'et: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} må allerede bruge hverdagskommandoerne."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} må nu bruge hverdagskommandoerne."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Alle i {name} må nu bruge hverdagskommandoerne der."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Botten er ikke med i gruppen: den svarer der, når den er tilføjet."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Der er ingen {n} i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} er ikke i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} kan være hvem som helst af {count} i {command}: angiv nummeret."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Timer {timers} poster stadig der: se /timers."
msgstr[1] "Timerne {timers} poster stadig der: se /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Ingen i {name} må nu bruge hverdagskommandoerne der."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} må ikke længere bruge hverdagskommandoerne."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Vedkommende er admin og må derfor stadig bruge dem."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Tillykke med navnedagen, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} fylder {age} i dag!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Tillykke med fødselsdagen, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "alle grupper"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Ingen fødselsdage her."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} fødselsdag"
msgstr[1] "🎂 {count} fødselsdage"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Ingen navnedage her."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} navnedag"
msgstr[1] "🌸 {count} navnedage"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(fylder {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr "Fødselsdage og navnedage vises i grupper, for dem, der er med i dem."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/fødselsdag tilføj <dato> [<chats>] <hvem>: en fødselsdag, f.eks."

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr ""
"/fødselsdag tilføj 1990-03-14 Alice: en kontakt, i grupperne, kontakten er "
"med i"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/fødselsdag tilføj 03-14 1,2 Mormor: nogen, der ikke er på Signal, i chat 1 "
"og 2 i /chats; uden dem i alle grupper"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr "/fødselsdag fjern <n>: fjern én, via dens nummer i /fødselsdage"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/navnedag tilføj <dato> [<chats>] <hvem>: en navnedag, f.eks."

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr ""
"/navnedag tilføj 08-08 Alice: en kontakt, i grupperne, kontakten er med i"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/navnedag tilføj 08-08 1,2 Mormor: nogen, der ikke er på Signal, i chat 1 og "
"2 i /chats; uden dem i alle grupper"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/navnedag fjern <n>: fjern én, via dens nummer i /navnedage"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Ingen hedder {who} i /kontakter."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Gem først {who} som kontakt, under det navn, der skal vises: /kontakter "
"tilføj {who} <navn>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} er ikke en dag: angiv den som 1990-03-14 eller 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "En navnedag har intet år: angiv den som 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} er ikke kommet endnu."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Et navn har højst {count} tegn."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} er ikke en gruppe: fødselsdage og navnedage vises kun i grupper."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} er der allerede, på den dag."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Der er allerede {count} fødselsdage og navnedage: fjern én først."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Tilføjet: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Ændret: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 I grupperne, som {name} er med i"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 I alle grupper: ingen kontakt hedder {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Kun i nogle grupper: tilføj den igen med deres numre i /chats: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Hvilken? Angiv dens nummer, som {command} viser det."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Hvilke? Send først {command} for at se deres numre."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} findes ikke længere: fjernet eller ændret siden."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Fjernet: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Botten besvarer højst {count} kommando fra hver person på {period}. Den "
"svarer dig igen om {wait}."
msgstr[1] ""
"⏳ Botten besvarer højst {count} kommandoer fra hver person på {period}. Den "
"svarer dig igen om {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "En genvej må ikke indeholde | eller ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr "{name} er et alias i konfigurationen: fjern det der først."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} er allerede en kommando."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ En redigering af {command} udføres ikke, da det, den gjorde, ikke kan "
"fortrydes. Send den som en ny besked i stedet."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
"✏️ Den redigering udføres ikke: botten er startet igen siden den redigerede "
"besked og kan derfor ikke vide, hvad den gjorde. Send den som en ny besked i "
"stedet."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: undoing what the message it edits did failed. Send it "
"as a new message instead."
msgstr ""
