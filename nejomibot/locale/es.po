msgstr "Para todos los permitidos"

#: nejomibot/help.py
msgid "Admins, in a direct chat"
msgstr "Administradores, en un chat privado"

#: nejomibot/help.py
msgid "Commands start with ., ! or /, whichever is easier to type."
msgstr "Los comandos empiezan por ., ! o /, lo que sea más fácil de escribir."

#: nejomibot/help.py
msgid "Every command takes its English name too."
msgstr "Todos los comandos admiten también su nombre en inglés."

#: nejomibot/help.py
#, python-brace-format
