#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin añadir <quién> [<idioma>]: hacer administrador a alguien, por su "
"número en /contactos, su número de teléfono, su ID de Signal o su nombre, y "
"enviarle una bienvenida; con un idioma, como es, el bot lo habla con esa "
"persona"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin quitar <n>: dejar de serlo, por su número en /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr ""
"Solo los administradores de la configuración añaden y quitan administradores."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Administradores ({count}):"

#: nejomibot/admins.py
msgid "in the config"
msgstr "en la configuración"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin añadir <quién> añade uno, /admin quitar <n> quita uno; solo pueden "
"hacerlo los administradores de la configuración."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} es un grupo: los administradores son personas."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "¡Bienvenido!"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} te ha hecho administrador de este bot."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Ahora eres administrador de este bot."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all. A few to start with:"
msgstr ""
"Aquí, en un chat privado con el bot, puedes usar todos los comandos: {help} "
"los muestra todos. Algunos para empezar:"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Gracias por ayudar a cuidar del bot."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "Se le envió una bienvenida, en {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr "Una bienvenida para esa persona, en {language}, espera a ser enviada."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "No se pudo enviar la bienvenida a esa persona."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Ese es el propio bot."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} ya es administrador en la configuración."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"El bot aún no conoce el ID de Signal de {name}, con el que se guardan los "
"administradores: lo conocerá cuando esa persona le haya escrito."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} ya es administrador."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "La lista está llena: {count} como máximo."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr "👑 {name} ya es administrador y puede usar todos los comandos."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "A partir de ahora el bot habla {language} con esa persona."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr ""
"{who} es administrador en la configuración, algo que ningún comando cambia."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} ya no es administrador."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr ""
"Esa persona está en /permitidos, así que aún puede usar los comandos "
"cotidianos."

#: nejomibot/albums.py nejomibot/status.py
#, python-brace-format
msgid "{count} photo"
msgid_plural "{count} photos"
msgstr[0] "{count} foto"
msgstr[1] "{count} fotos"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} álbum"
msgstr[1] "📚 {count} álbumes"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 No hay álbumes: cada carpeta de la fototeca es uno."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} foto sin álbum"
msgstr[1] "📷 {count} fotos sin álbum"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <álbum>: el álbum. /album <álbum> 2019-06-15: la fecha de nacimiento "
"desde la que sus pies de foto cuentan una edad; /album <álbum> -: ninguna. /"
"album <álbum> atajos /alice: otros nombres para /foto <álbum>; /album "
"<álbum> atajos -: ninguno. /álbumes muestra los álbumes."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Nacido el {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr ""
"Sin fecha de nacimiento, así que sus pies de foto no muestran ninguna edad"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Atajos: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Sin atajos"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr ""
"✅ {album}: nacido el {day}, así que sus pies de foto muestran la edad."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} no tiene fecha de nacimiento."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr ""
"✅ {album}: sin fecha de nacimiento, así que sus pies de foto no muestran "
"ninguna edad."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} ya es un atajo de {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} no tiene atajos."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: sin atajos."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Un álbum tiene como máximo {count} atajos."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Atajos de /foto {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} no es una fecha como 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Envía /permitir y a quién: un número de teléfono, un ID de Signal o de "
"grupo, el nombre de un grupo en el que esté el bot, o alguien de /contactos, "
"por su número ahí o su nombre."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Envía /denegar y a quién: su número en /permitidos, su número de teléfono, "
"su ID de Signal o de grupo, o su nombre."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr ""
"{who} es administrador y puede usar todos los comandos: consulta /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(el bot no está en él)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Quién puede usar los comandos cotidianos ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Los administradores pueden usar todos los comandos: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/permitir <quién> añade a alguien, /denegar <n> quita a alguien."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "No hay número de teléfono ni ID para {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Ninguna persona ni ningún grupo se llama {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} puede ser cualquiera de {count}, indica su ID: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} ya puede usar los comandos cotidianos."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} ya puede usar los comandos cotidianos."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Todos en {name} ya pueden usar ahí los comandos cotidianos."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "El bot no está en el grupo: responderá ahí cuando lo añadan."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "No hay ningún {n} en {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} no está en {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} puede ser cualquiera de {count} en {command}: indica su número."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "El temporizador {timers} todavía publica ahí: consulta /timers."
msgstr[1] "Los temporizadores {timers} todavía publican ahí: consulta /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Ya nadie en {name} puede usar ahí los comandos cotidianos."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} ya no puede usar los comandos cotidianos."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Esa persona es administrador, así que aún puede usarlos."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 ¡Feliz santo, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 ¡{name} cumple {age} años hoy!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 ¡Feliz cumpleaños, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "todos los grupos"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "No hay cumpleaños aquí."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} cumpleaños"
msgstr[1] "🎂 {count} cumpleaños"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "No hay santos aquí."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} santo"
msgstr[1] "🌸 {count} santos"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(cumple {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr ""
"Los cumpleaños y los santos se muestran en los grupos, para sus miembros."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/birthday añadir <fecha> [<chats>] <quién>: un cumpleaños, por ejemplo"

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr "/birthday añadir 1990-03-14 Alice: un contacto, en sus grupos"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/birthday añadir 03-14 1,2 Abuela: alguien que no está en Signal, en los "
"chats 1 y 2 de /chats; sin ellos, en todos los grupos"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr "/birthday quitar <n>: quitar uno, por su número en /cumpleaños"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/santo añadir <fecha> [<chats>] <quién>: un santo, por ejemplo"

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr "/santo añadir 08-08 Alice: un contacto, en sus grupos"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/santo añadir 08-08 1,2 Abuela: alguien que no está en Signal, en los chats "
"1 y 2 de /chats; sin ellos, en todos los grupos"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/santo quitar <n>: quitar uno, por su número en /santos"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Nadie se llama {who} en /contactos."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Guarda primero a {who} como contacto, con el nombre que debe mostrarse: /"
"contactos añadir {who} <nombre>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} no es un día: indícalo como 1990-03-14 o 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "Un santo no tiene año: indícalo como 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} todavía no ha llegado."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Un nombre tiene como máximo {count} caracteres."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} no es un grupo: los cumpleaños y los santos solo se muestran en "
"grupos."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} ya está ahí, ese día."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Ya hay {count} cumpleaños y santos: quita uno primero."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Añadido: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Cambiado: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 En los grupos de {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 En todos los grupos: ningún contacto se llama {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Solo en algunos grupos: añádelo de nuevo con sus números de /chats: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "¿Cuál? Indica su número, tal como lo muestra {command}."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "¿Cuáles? Envía primero {command} para ver sus números."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} ya no existe: se quitó o cambió desde entonces."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Quitado: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ El bot responde como mucho a {count} comando de cada persona en {period}. "
"Te vuelve a responder en {wait}."
msgstr[1] ""
"⏳ El bot responde como mucho a {count} comandos de cada persona en "
"{period}. Te vuelve a responder en {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "Un atajo no puede contener | ni ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr "{name} es un alias en la configuración: quítalo de ahí primero."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} ya es un comando."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ Una edición de {command} no se ejecuta, ya que lo que hizo no se puede "
"deshacer. Envíala como un mensaje nuevo."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
"✏️ Esa edición no se ejecuta: el bot se ha reiniciado desde el mensaje que "
"edita, así que no puede saber qué hizo. Envíala como un mensaje nuevo."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: undoing what the message it edits did failed. Send it "
"as a new message instead."
msgstr ""
