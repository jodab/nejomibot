msgstr "✅ {album} : né le {day}, donc ses légendes indiquent l'âge."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date of its own."
msgstr "{album} n'a pas de date de naissance propre."

#: nejomibot/albums.py
#, python-brace-format
msgid ""
"✅ {album}: no birth date of its own, so photos_birth_date's, {day}, counts."
msgstr ""
"✅ {album} : pas de date de naissance propre, donc celle de "
"photos_birth_date, {day}, s'applique."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr ""
"✅ {album} : pas de date de naissance, donc ses légendes n'indiquent aucun "
"âge."

