msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} album"
msgstr[1] "📚 {count} albums"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Aucun album : chaque dossier de la photothèque en est un."

