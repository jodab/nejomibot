msgid_plural "{count} photos"
msgstr[0] "{count} photo"
msgstr[1] "{count} photos"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} album"
msgstr[1] "📚 {count} albums"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Aucun album : chaque dossier de la photothèque en est un."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} photo hors album"
msgstr[1] "📷 {count} photos hors album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <album> : l'album. /album <album> 2019-06-15 : la date de naissance à "
"partir de laquelle ses légendes comptent un âge ; /album <album> - : "
"aucune. /album <album> raccourcis /alice : d'autres noms pour /photo "
"<album> ; /album <album> raccourcis - : aucun. /albums liste les albums."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Né le {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Pas de date de naissance, donc ses légendes n'indiquent aucun âge"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Raccourcis : {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Aucun raccourci"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr "✅ {album} : né le {day}, donc ses légendes indiquent l'âge."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} n'a pas de date de naissance."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr ""
"✅ {album} : pas de date de naissance, donc ses légendes n'indiquent aucun "
"âge."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} est déjà un raccourci pour {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} n'a aucun raccourci."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album} : aucun raccourci."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Un album a au plus {count} raccourcis."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Raccourcis pour /photo {album} : {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} n'est pas une date comme 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Envoyez /autoriser suivi de qui : un numéro de téléphone, un identifiant "
"Signal ou de groupe, le nom d'un groupe dont le bot fait partie, ou une "
"personne de /contacts, par son numéro dans la liste ou son nom."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Envoyez /interdire suivi de qui : son numéro dans /autorisés, son numéro de "
"téléphone, son identifiant Signal ou de groupe, ou son nom."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr ""
"{who} est administrateur et peut utiliser toutes les commandes : voir /"
"admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(le bot n'en fait pas partie)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Qui peut utiliser les commandes courantes ({count}) :"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Les administrateurs peuvent utiliser toutes les commandes : {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/autoriser <qui> en ajoute un, /interdire <n> en supprime un."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Aucun numéro de téléphone ni identifiant pour {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Aucune personne ni aucun groupe ne s'appelle {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} peut désigner {count} personnes, indiquez l'identifiant : {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} peut déjà utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} peut désormais utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr ""
"✅ Tous les membres de {name} peuvent désormais y utiliser les commandes "
"courantes."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Le bot ne fait pas partie du groupe : il y répondra une fois ajouté."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Il n'y a pas de {n} dans {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} ne figure pas dans {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} peut désigner {count} entrées de {command} : indiquez le numéro."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Le minuteur {timers} y publie toujours : voir /timers."
msgstr[1] "Les minuteurs {timers} y publient toujours : voir /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr ""
"🗑️ Plus personne dans {name} ne peut y utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} ne peut plus utiliser les commandes courantes."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Cette personne est administrateur et peut donc toujours les utiliser."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Bonne fête, {name} !"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} a {age} ans aujourd'hui !"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Joyeux anniversaire, {name} !"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "tous les groupes"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Aucun anniversaire ici."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} anniversaire"
msgstr[1] "🎂 {count} anniversaires"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Aucune fête ici."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} fête"
msgstr[1] "🌸 {count} fêtes"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(aura {age} ans)"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr ""
"Les anniversaires et les fêtes s'affichent dans les groupes, pour leurs "
"membres."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr ""
"/anniversaire ajouter <date> [<conversations>] <qui> : un anniversaire, par "
"exemple"

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr "/anniversaire ajouter 1990-03-14 Alice : un contact, dans ses groupes"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/anniversaire ajouter 03-14 1,2 Mamie : une personne qui n'est pas sur "
"Signal, dans les conversations 1 et 2 de /chats ; sans elles, dans tous les "
"groupes"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr ""
"/anniversaire supprimer <n> : en supprimer un, par son numéro dans /"
"anniversaires"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/fête ajouter <date> [<conversations>] <qui> : une fête, par exemple"

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr "/fête ajouter 08-08 Alice : un contact, dans ses groupes"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/fête ajouter 08-08 1,2 Mamie : une personne qui n'est pas sur Signal, dans "
"les conversations 1 et 2 de /chats ; sans elles, dans tous les groupes"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/fête supprimer <n> : en supprimer une, par son numéro dans /fêtes"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Personne ne s'appelle {who} dans /contacts."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Enregistrez d'abord {who} comme contact, sous le nom à afficher : /contacts "
"ajouter {who} <nom>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr ""
"{text} n'est pas un jour : indiquez-le sous la forme 1990-03-14 ou 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "Une fête n'a pas d'année : indiquez-la sous la forme 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} n'est pas encore arrivé."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Un nom a au plus {count} caractères."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} n'est pas un groupe : les anniversaires et les fêtes ne s'affichent "
"que dans les groupes."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} y figure déjà, ce jour-là."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Il y a déjà {count} anniversaires et fêtes : supprimez-en un d'abord."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Ajouté : {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Modifié : {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 Dans les groupes de {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 Dans tous les groupes : aucun contact ne s'appelle {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Pour certains groupes seulement, refaites l'ajout avec leurs numéros dans /"
"chats : {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Lequel ? Indiquez son numéro, tel que {command} l'affiche."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Lesquels ? Envoyez d'abord {command} pour connaître leurs numéros."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} n'existe plus : supprimé ou modifié entre-temps."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Supprimé : {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Le bot répond au plus à {count} commande de chaque personne en {period}. "
"Il vous répond à nouveau dans {wait}."
msgstr[1] ""
"⏳ Le bot répond au plus à {count} commandes de chaque personne en {period}. "
"Il vous répond à nouveau dans {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "Un raccourci ne peut contenir ni | ni ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr ""
"{name} est un alias de la configuration : retirez-le d'abord de celle-ci."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} est déjà une commande."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ Une modification de {command} n'est pas exécutée, car son effet ne peut "
"pas être annulé. Envoyez-la plutôt comme nouveau message."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
