msgstr "{text} n'est pas une date comme 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Envoyez /autoriser suivi de qui : un numéro de téléphone, un identifiant "
"Signal ou de groupe, le nom d'un groupe dont le bot fait partie, ou une "
"personne de /contacts, par son numéro dans la liste ou son nom."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Envoyez /interdire suivi de qui : son numéro dans /autorisés, son numéro de "
"téléphone, son identifiant Signal ou de groupe, ou son nom."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr ""
"{who} est administrateur et peut utiliser toutes les commandes : voir /"
"admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(le bot n'en fait pas partie)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Qui peut utiliser les commandes courantes ({count}) :"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Les administrateurs peuvent utiliser toutes les commandes : {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/autoriser <qui> en ajoute un, /interdire <n> en supprime un."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Aucun numéro de téléphone ni identifiant pour {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Aucune personne ni aucun groupe ne s'appelle {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} peut désigner {count} personnes, indiquez l'identifiant : {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} peut déjà utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} peut désormais utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr ""
"✅ Tous les membres de {name} peuvent désormais y utiliser les commandes "
"courantes."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Le bot ne fait pas partie du groupe : il y répondra une fois ajouté."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Il n'y a pas de {n} dans {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} ne figure pas dans {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} peut désigner {count} entrées de {command} : indiquez le numéro."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Le minuteur {timers} y publie toujours : voir /timers."
msgstr[1] "Les minuteurs {timers} y publient toujours : voir /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr ""
"🗑️ Plus personne dans {name} ne peut y utiliser les commandes courantes."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} ne peut plus utiliser les commandes courantes."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Cette personne est administrateur et peut donc toujours les utiliser."

