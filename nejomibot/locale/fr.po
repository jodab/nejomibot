#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin ajouter <qui> [<langue>] : nommer quelqu'un administrateur, par son "
"numéro dans /contacts, son numéro de téléphone, son identifiant Signal ou "
"son nom, et lui envoyer un message de bienvenue ; avec une langue, par "
"exemple fr, le bot la parle avec cette personne"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin supprimer <n> : ne plus l'être, par son numéro dans /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr ""
"Seuls les administrateurs de la configuration ajoutent et suppriment des "
"administrateurs."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Administrateurs ({count}) :"

#: nejomibot/admins.py
msgid "in the config"
msgstr "dans la configuration"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin ajouter <qui> en ajoute un, /admin supprimer <n> en supprime un ; "
"seuls les administrateurs de la configuration le peuvent."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} est un groupe : les administrateurs sont des personnes."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "Bienvenue !"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} vous a nommé administrateur de ce bot."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Vous êtes désormais administrateur de ce bot."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all, with what each takes. A few to start with:"
msgstr ""
"Ici, dans une conversation privée avec le bot, vous pouvez utiliser toutes "
"les commandes : {help} les liste toutes, avec ce que chacune accepte. "
"Quelques-unes pour commencer :"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Merci de nous aider à veiller sur le bot."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "Un message de bienvenue lui a été envoyé, en {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr ""
"Un message de bienvenue pour cette personne, en {language}, attend d'être "
"envoyé."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "Le message de bienvenue n'a pas pu lui être envoyé."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "C'est le bot lui-même."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} est déjà administrateur dans la configuration."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"Le bot ne connaît pas encore l'identifiant Signal de {name}, sous lequel les "
"administrateurs sont enregistrés : il le connaîtra dès que cette personne "
"lui aura écrit."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} est déjà administrateur."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "La liste est pleine : {count} au maximum."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr ""
"👑 {name} est désormais administrateur et peut utiliser toutes les commandes."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "Le bot parle désormais {language} avec cette personne."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr ""
"{who} est administrateur dans la configuration, ce qu'aucune commande ne "
"modifie."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} n'est plus administrateur."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr ""
"Cette personne figure dans /autorisés et peut donc toujours utiliser les "
"commandes courantes."

