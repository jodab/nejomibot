#: nejomibot/profile.py
msgid "Send /name <new name>."
msgstr "Envoyez /nom <nouveau nom>."

#: nejomibot/profile.py
msgid "Send /about <text>, or /about remove."
msgstr "Envoyez /àpropos <texte>, ou /àpropos supprimer."

#: nejomibot/profile.py
msgid "Send a picture with /avatar as its caption, or /avatar remove."
msgstr ""
"Envoyez une image avec /photoprofil en légende, ou /photoprofil supprimer."

#: nejomibot/profile.py
msgid ""
"Send /username <name>, or /username remove. A name is 3 to 32 letters, "
"digits or _, not starting with a digit; Signal adds a number to it, like "
"mybot.42, unless you give one."
msgstr ""
"Envoyez /pseudo <nom>, ou /pseudo supprimer. Un nom comporte de 3 à 32 "
"lettres, chiffres ou _, et ne commence pas par un chiffre ; Signal y ajoute "
"un nombre, comme mybot.42, sauf si vous en indiquez un."

#: nejomibot/profile.py
msgid "Give the bot a name first: Signal's profile needs one."
msgstr "Donnez d'abord un nom au bot : le profil Signal en exige un."

#: nejomibot/profile.py
msgid ""
"signal-cli didn't keep the picture, so it can't be the avatar. It keeps none "
"while it runs with JSON_RPC_IGNORE_ATTACHMENTS=true; nejomibot-account can "
"set the avatar from a file instead."
msgstr ""
"signal-cli n'a pas conservé l'image, elle ne peut donc pas devenir la photo "
"de profil. Il n'en conserve aucune tant qu'il tourne avec "
"JSON_RPC_IGNORE_ATTACHMENTS=true ; nejomibot-account peut définir la photo "
"de profil à partir d'un fichier à la place."

#: nejomibot/profile.py
msgid ""
"signal-cli can't give back the avatar, and the change would remove it: /"
"avatar remove first, then set it again."
msgstr ""
"signal-cli ne peut pas restituer la photo de profil, et la modification la "
"supprimerait : faites d'abord /photoprofil supprimer, puis définissez-la à "
"nouveau."

