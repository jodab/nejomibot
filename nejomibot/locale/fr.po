#: nejomibot/timers.py
#, python-brace-format
msgid ""
"<when> is a time (08:00, or 08:00,18:30), days and a time (mon-fri 07:30, "
"sat,sun 10:00), a date and a time for once ({date} 15:00, tomorrow 08:00), "
"or every 2h or 30m"
msgstr ""
"<quand> est une heure (08:00, ou 08:00,18:30), des jours et une heure (lun-"
"ven 07:30, sam,dim 10:00), une date et une heure pour une seule fois ({date} "
"15:00, demain 08:00), ou chaque 2h ou 30m"

#: nejomibot/timers.py
msgid "/chats: where timers can post, numbered"
msgstr "/chats : où les minuteurs peuvent publier, numérotés"

#: nejomibot/timers.py
msgid "/timers: the timers"
msgstr "/timers : les minuteurs"

#: nejomibot/timers.py
msgid "/timer add <when> [<chats>] <commands>: a new one, e.g."
msgstr ""
"/timer ajouter <quand> [<conversations>] <commandes> : un nouveau, par "
"exemple"

#: nejomibot/timers.py
msgid "/timer add mon-fri 07:30 1,2 /weather; /photo"
msgstr "/timer ajouter lun-ven 07:30 1,2 /météo ; /photo"

#: nejomibot/timers.py
msgid "The chats are numbers from /chats; without them, it posts to you."
msgstr ""
"Les conversations sont des numéros de /chats ; sans elles, il vous écrit à "
"vous."

#: nejomibot/timers.py
msgid "/timer remove <n>, /timer run <n>: remove one, or run it now"
msgstr ""
"/timer supprimer <n>, /timer exécuter <n> : en supprimer un, ou l'exécuter "
"maintenant"

#: nejomibot/timers.py
#, python-brace-format
msgid "{when_help}, in {zone} time."
msgstr "{when_help}, à l'heure de {zone}."

#: nejomibot/timers.py
msgid "Every how long? Like every 30m, every 2h or every 1h30m."
msgstr "Tous les combien ? Par exemple chaque 30m, chaque 2h ou chaque 1h30m."

#: nejomibot/timers.py
#, python-brace-format
msgid "Not more often than every {every}."
msgstr "Pas plus souvent que toutes les {every}."

#: nejomibot/timers.py
#, python-brace-format
msgid "There's no such day as {day}."
msgstr "Le jour {day} n'existe pas."

#: nejomibot/timers.py
msgid "At what time?"
msgstr "À quelle heure ?"

#: nejomibot/timers.py
msgid "A timer on a date runs once: give it one time, and no days."
msgstr ""
"Un minuteur à une date s'exécute une seule fois : donnez-lui une heure, et "
"aucun jour."

#: nejomibot/timers.py
#, python-brace-format
msgid "Timers, specials and /run can't run {command}."
msgstr ""
"Les minuteurs, les commandes spéciales et /exécuter ne peuvent pas exécuter "
"{command}."

#: nejomibot/timers.py
msgid "A timer's commands can't have a |: the timers file uses it."
msgstr ""
"Les commandes d'un minuteur ne peuvent pas contenir de | : le fichier des "
"minuteurs l'utilise."

#: nejomibot/timers.py
#, python-brace-format
msgid "{command} isn't a command the bot knows."
msgstr "{command} n'est pas une commande que le bot connaît."

#: nejomibot/timers.py
#, python-brace-format
msgid "Commands start with . or /, unlike {command}."
msgstr "Les commandes commencent par . ou /, contrairement à {command}."

