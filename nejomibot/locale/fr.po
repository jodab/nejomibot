msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} photo hors album"
msgstr[1] "📷 {count} photos hors album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none of its own. /album "
"<album> shortcuts /alice alice: other names for /photo <album>; /album "
"<album> shortcuts -: none. /albums lists the albums."
msgstr ""
"/album <album> : l'album. /album <album> 2019-06-15 : la date de naissance à "
"partir de laquelle ses légendes comptent un âge ; /album <album> - : aucune "
"date propre. /album <album> raccourcis /alice alice : d'autres noms pour /"
"photo <album> ; /album <album> raccourcis - : aucun. /albums liste les "
"albums."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Né le {day}"

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}, as photos_birth_date has it"
msgstr "Né le {day}, d'après photos_birth_date"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Pas de date de naissance, donc ses légendes n'indiquent aucun âge"

