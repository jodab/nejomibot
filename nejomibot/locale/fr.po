#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Bonne fête, {name} !"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} a {age} ans aujourd'hui !"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Joyeux anniversaire, {name} !"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "tous les groupes"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Aucun anniversaire ici."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} anniversaire"
msgstr[1] "🎂 {count} anniversaires"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Aucune fête ici."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} fête"
msgstr[1] "🌸 {count} fêtes"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(aura {age} ans)"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr ""
"Les anniversaires et les fêtes s'affichent dans les groupes, pour leurs "
"membres."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr ""
"/anniversaire ajouter <date> [<conversations>] <qui> : un anniversaire, par "
"exemple"

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr "/anniversaire ajouter 1990-03-14 Alice : un contact, dans ses groupes"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/anniversaire ajouter 03-14 1,2 Mamie : une personne qui n'est pas sur "
"Signal, dans les conversations 1 et 2 de /chats ; sans elles, dans tous les "
"groupes"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr ""
"/anniversaire supprimer <n> : en supprimer un, par son numéro dans /"
"anniversaires"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/fête ajouter <date> [<conversations>] <qui> : une fête, par exemple"

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr "/fête ajouter 08-08 Alice : un contact, dans ses groupes"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/fête ajouter 08-08 1,2 Mamie : une personne qui n'est pas sur Signal, dans "
"les conversations 1 et 2 de /chats ; sans elles, dans tous les groupes"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/fête supprimer <n> : en supprimer une, par son numéro dans /fêtes"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Personne ne s'appelle {who} dans /contacts."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Enregistrez d'abord {who} comme contact, sous le nom à afficher : /contacts "
"ajouter {who} <nom>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr ""
"{text} n'est pas un jour : indiquez-le sous la forme 1990-03-14 ou 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "Une fête n'a pas d'année : indiquez-la sous la forme 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} n'est pas encore arrivé."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Un nom a au plus {count} caractères."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} n'est pas un groupe : les anniversaires et les fêtes ne s'affichent "
"que dans les groupes."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} y figure déjà, ce jour-là."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Il y a déjà {count} anniversaires et fêtes : supprimez-en un d'abord."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Ajouté : {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Modifié : {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 Dans les groupes de {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 Dans tous les groupes : aucun contact ne s'appelle {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Pour certains groupes seulement, refaites l'ajout avec leurs numéros dans /"
"chats : {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Lequel ? Indiquez son numéro, tel que {command} l'affiche."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Lesquels ? Envoyez d'abord {command} pour connaître leurs numéros."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} n'existe plus : supprimé ou modifié entre-temps."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Supprimé : {what}"

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "Un raccourci ne peut contenir ni | ni ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
