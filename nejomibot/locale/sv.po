msgstr "Admins, i en direktchatt"

#: nejomibot/help.py
msgid "Commands start with ., ! or /, whichever is easier to type."
msgstr "Kommandon börjar med ., ! eller /, det som är lättast att skriva."

#: nejomibot/help.py
msgid "Every command takes its English name too."
msgstr "Alla kommandon fungerar också med sina engelska namn."

