msgid ""
"<chats> – numbers from /chats, like 1,2; a timer without them posts to you"
msgstr ""
"<chattar> – nummer från /chats, som 1,2; en timer utan dem postar till dig"

#: nejomibot/help.py
msgid ""
"<parts> – text and commands, separated by ;, e.g. Good morning! /weather; /"
"dailyquote"
msgstr ""
"<delar> – text och kommandon, åtskilda med ;, t.ex. God morgon! /väder; /"
"dagenscitat"

