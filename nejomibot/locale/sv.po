#: nejomibot/help.py
msgid ""
"<who> – a name, number or ID, as /contacts shows; /allow takes groups too"
msgstr ""
"<vem> – ett namn, nummer eller ID, som /kontakter visar; /tillåt tar även "
"grupper"

#: nejomibot/help.py
msgid "<n> – a number from /allowed or /timers"
msgstr "<n> – ett nummer från /tillåtna eller /timers"

#: nejomibot/help.py
#, python-brace-format
