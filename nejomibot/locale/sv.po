#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin lägg till <vem> [<språk>]: gör någon till admin, med numret i /"
"kontakter, telefonnummer, Signal-ID eller namn, och skicka ett "
"välkomstmeddelande; med ett språk, t.ex. sv, talar boten det med hen"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin ta bort <n>: inte längre, med numret i /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr "Bara admins i konfigurationen lägger till och tar bort admins."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Admins ({count}):"

#: nejomibot/admins.py
msgid "in the config"
msgstr "i konfigurationen"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin lägg till <vem> lägger till en, /admin ta bort <n> tar bort en; bara "
"admins i konfigurationen kan göra det."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} är en grupp: admins är personer."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "Välkommen!"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} har gjort dig till admin för den här boten."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Du är admin för den här boten nu."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all. A few to start with:"
msgstr ""
"Här, i en direktchatt med boten, får du använda alla kommandon: {help} "
"listar dem alla. Några att börja med:"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Tack för att du hjälper till att ta hand om boten."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "Ett välkomstmeddelande gick till hen, på {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr "Ett välkomstmeddelande till hen, på {language}, väntar på att skickas."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "Välkomstmeddelandet till hen kunde inte skickas."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Det är boten själv."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} är redan admin i konfigurationen."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"Boten känner inte till Signal-ID:t för {name} ännu, som admins sparas med: "
"när hen har skrivit till boten gör den det."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} är redan admin."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "Listan är full: högst {count}."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr "👑 {name} är admin nu och får använda alla kommandon."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "Boten talar {language} med hen från och med nu."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr "{who} är admin i konfigurationen, vilket inget kommando ändrar."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} är inte längre admin."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr "Hen står i /tillåtna och får fortfarande använda vardagskommandona."

#: nejomibot/albums.py nejomibot/status.py
#, python-brace-format
msgid "{count} photo"
msgid_plural "{count} photos"
msgstr[0] "{count} bild"
msgstr[1] "{count} bilder"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} album"
msgstr[1] "📚 {count} album"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Inga album: varje mapp i bildarkivet är ett."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} bild utan album"
msgstr[1] "📷 {count} bilder utan album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <album>: albumet. /album <album> 2019-06-15: födelsedatumet som "
"bildtexterna räknar en ålder från; /album <album> -: inget. /album <album> "
"genvägar /alice: andra namn för /bild <album>; /album <album> genvägar -: "
"inga. /albums visar albumen."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Född {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Inget födelsedatum, så bildtexterna visar ingen ålder"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Genvägar: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Inga genvägar"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr "✅ {album}: född {day}, så bildtexterna visar åldern."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} har inget födelsedatum."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr "✅ {album}: inget födelsedatum, så bildtexterna visar ingen ålder."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} är redan en genväg för {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} har inga genvägar."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: inga genvägar."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Ett album har högst {count} genvägar."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Genvägar för /bild {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} är inget datum: ange det som 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Skicka /allow och vem: ett telefonnummer, Signal-ID eller grupp-ID, namnet "
"på en grupp boten är med i, eller någon i /contacts, med numret där eller "
"namnet."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Skicka /disallow och vem: numret i /allowed, telefonnummer, Signal-ID eller "
"grupp-ID, eller namn."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr "{who} är admin och får använda alla kommandon: se /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(boten är inte med i den)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Vilka som får använda vardagskommandona ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Admins får använda alla kommandon: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/allow <vem> lägger till, /disallow <n> tar bort."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Inget telefonnummer eller ID för {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Ingen person eller grupp heter {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} kan syfta på {count}, ange ID: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} får redan använda vardagskommandona."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} får använda vardagskommandona nu."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Alla i {name} får använda vardagskommandona där nu."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Boten är inte med i gruppen: den svarar där när den har lagts till."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Det finns ingen {n} i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} finns inte i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} kan syfta på {count} i {command}: ange numret."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Timern {timers} postar fortfarande där: se /timers."
msgstr[1] "Timrarna {timers} postar fortfarande där: se /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Ingen i {name} får använda vardagskommandona där längre."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} får inte längre använda vardagskommandona."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Hen är admin och får fortfarande använda dem."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Grattis på namnsdagen, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} fyller {age} år idag!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Grattis på födelsedagen, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "alla grupper"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Inga födelsedagar här."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} födelsedag"
msgstr[1] "🎂 {count} födelsedagar"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Inga namnsdagar här."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} namnsdag"
msgstr[1] "🌸 {count} namnsdagar"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(fyller {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr "Födelsedagar och namnsdagar visas i grupper, för dem som är med i dem."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/födelsedag lägg till <datum> [<chattar>] <vem>: en födelsedag, t.ex."

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr ""
"/födelsedag lägg till 1990-03-14 Alice: en kontakt, i grupperna kontakten är "
"med i"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/födelsedag lägg till 03-14 1,2 Mormor: någon som inte har Signal, i chatt 1 "
"och 2 i /chats; utan dem, i alla grupper"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr "/födelsedag ta bort <n>: ta bort en, med dess nummer i /födelsedagar"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/namnsdag lägg till <datum> [<chattar>] <vem>: en namnsdag, t.ex."

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr ""
"/namnsdag lägg till 08-08 Alice: en kontakt, i grupperna kontakten är med i"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/namnsdag lägg till 08-08 1,2 Mormor: någon som inte har Signal, i chatt 1 "
"och 2 i /chats; utan dem, i alla grupper"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/namnsdag ta bort <n>: ta bort en, med dess nummer i /namnsdagar"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Ingen som heter {who} i /kontakter."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Spara {who} som kontakt först, med namnet som ska visas: /kontakter lägg "
"till {who} <namn>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} är inget datum: ange det som 1990-03-14, eller 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "En namnsdag har inget år: ange den som 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} har inte kommit än."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Ett namn har högst {count} tecken."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr "{name} är ingen grupp: de visas bara i grupper."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} finns redan, på den dagen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Det finns redan {count} födelsedagar och namnsdagar: ta bort en först."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Tillagd: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Ändrad: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 I grupperna {name} är med i"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 I alla grupper: ingen kontakt heter {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Bara i vissa grupper: lägg till den igen med deras nummer i /chats: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Vilken? Ange dess nummer, som {command} visar."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Vilka? Skicka {command} först, för deras nummer."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} finns inte längre: borttagen eller ändrad sedan dess."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Borttaget: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Boten svarar på högst {count} kommando från varje person på {period}. Den "
"svarar dig igen om {wait}."
msgstr[1] ""
"⏳ Boten svarar på högst {count} kommandon från varje person på {period}. "
"Den svarar dig igen om {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "En genväg kan inte innehålla | eller ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr "{name} är ett alias i konfigurationen: ta bort det där först."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} är redan ett kommando."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ En ändring av {command} körs inte, eftersom det den gjorde inte går att "
"ångra. Skicka det som ett nytt meddelande i stället."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
"✏️ Ändringen körs inte: boten har startat om sedan meddelandet den ändrar, så "
"den kan inte veta vad det gjorde. Skicka det som ett nytt meddelande i "
"stället."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: undoing what the message it edits did failed. Send it "
"as a new message instead."
msgstr ""
