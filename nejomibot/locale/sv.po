#: nejomibot/account.py
msgid "today"
msgstr "idag"

#: nejomibot/account.py
msgid "yesterday"
msgstr "igår"

#: nejomibot/account.py
msgid "primary"
msgstr "primär"

#: nejomibot/account.py
#, python-brace-format
msgid "(seen {day})"
msgstr "(senast sedd {day})"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} contact"
msgid_plural "{count} contacts"
msgstr[0] "{count} kontakt"
msgstr[1] "{count} kontakter"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} known recipient"
msgid_plural "{count} known recipients"
msgstr[0] "{count} känd mottagare"
msgstr[1] "{count} kända mottagare"

#: nejomibot/account.py nejomibot/status.py
#, python-brace-format
msgid "blocked: {who}"
msgstr "blockerade: {who}"

#: nejomibot/account.py
#, python-brace-format
msgid "Safety numbers: {trusted} trusted ({verified} verified)"
msgstr "Säkerhetsnummer: {trusted} betrodda ({verified} verifierade)"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} untrusted"
msgstr "{count} ej betrodda"

#: nejomibot/account.py
#, python-brace-format
msgid "New or changed in the last week: {who}"
msgstr "Nya eller ändrade den senaste veckan: {who}"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} group (admin in {admin})"
msgid_plural "{count} groups (admin in {admin})"
msgstr[0] "{count} grupp (admin i {admin})"
msgstr[1] "{count} grupper (admin i {admin})"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} other member"
msgid_plural "{count} other members"
msgstr[0] "{count} annan medlem"
msgstr[1] "{count} andra medlemmar"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} left"
msgstr "har lämnat {count}"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} pending invite"
msgid_plural "{count} pending invites"
msgstr[0] "{count} väntande inbjudan"
msgstr[1] "{count} väntande inbjudningar"

#: nejomibot/account.py
#, python-brace-format
msgid "Asking to join: {groups}"
msgstr "Vill gå med: {groups}"

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, or the name of a "
"group the bot is in or of someone in /contacts."
msgstr ""
"Skicka /allow och vem: ett telefonnummer, Signal-ID eller grupp-ID, eller "
"namnet på en grupp boten är med i eller på någon i /contacts."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Skicka /disallow och vem: numret i /allowed, telefonnummer, Signal-ID eller "
"grupp-ID, eller namn."

#: nejomibot/allowed.py
#, python-brace-format
msgid ""
"{who} is an admin. Admins are in the config, and may always use every "
"command."
msgstr ""
"{who} är admin. Admins står i konfigurationen och får alltid använda alla "
"kommandon."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(boten är inte med i den)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Vilka som får använda vardagskommandona ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Admins, in the config, may use every command: {admins}"
msgstr "Admins, i konfigurationen, får använda alla kommandon: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/allow <vem> lägger till, /disallow <n> tar bort."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Ingen person eller grupp heter {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} kan syfta på {count}, ange ID: {ids}"

#: nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Det är boten själv."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} får redan använda vardagskommandona."

#: nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "Listan är full: högst {count}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} får använda vardagskommandona nu."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Alla i {name} får använda vardagskommandona där nu."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Boten är inte med i gruppen: den svarar där när den har lagts till."

#: nejomibot/allowed.py
#, python-brace-format
msgid "There's no {n} in /allowed."
msgstr "Det finns inget nummer {n} i /allowed."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in /allowed."
msgstr "{who} finns inte i /allowed."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in /allowed: give its number."
msgstr "{who} kan syfta på {count} i /allowed: ange numret."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Timern {timers} postar fortfarande där: se /timers."
msgstr[1] "Timrarna {timers} postar fortfarande där: se /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Ingen i {name} får använda vardagskommandona där längre."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} får inte längre använda vardagskommandona."

#: nejomibot/allowed.py
msgid "They're an admin, in the config, so may still use them."
msgstr "Hen är admin, i konfigurationen, och får fortfarande använda dem."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Grattis på namnsdagen, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} fyller {age} år idag!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Grattis på födelsedagen, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "alla grupper"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Inga födelsedagar här."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} födelsedag"
msgstr[1] "🎂 {count} födelsedagar"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Inga namnsdagar här."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} namnsdag"
msgstr[1] "🌸 {count} namnsdagar"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(fyller {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr "Födelsedagar och namnsdagar visas i grupper, för dem som är med i dem."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/födelsedag add <datum> [<chattar>] <vem>: en födelsedag, t.ex."

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr ""
"/födelsedag add 1990-03-14 Alice: en kontakt, i grupperna kontakten är med i"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/födelsedag add 03-14 1,2 Mormor: någon som inte har Signal, i chatt 1 och 2 "
"i /chats; utan dem, i alla grupper"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr "/födelsedag remove <n>: ta bort en, med dess nummer i /födelsedagar"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, as /birthday takes it"
msgstr ""
"/namnsdag add <datum> [<chattar>] <vem>: en namnsdag, som /födelsedag tar den"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/namnsdag remove <n>: ta bort en, med dess nummer i /namnsdagar"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Ingen som heter {who} i /kontakter."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Spara {who} som kontakt först, med namnet som ska visas: /kontakter add "
"{who} <namn>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} är inget datum: ange det som 1990-03-14, eller 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "En namnsdag har inget år: ange den som 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} har inte kommit än."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Ett namn har högst {count} tecken."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr "{name} är ingen grupp: de visas bara i grupper."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} finns redan, på den dagen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Det finns redan {count} födelsedagar och namnsdagar: ta bort en först."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Tillagd: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Ändrad: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 I grupperna {name} är med i"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 I alla grupper: ingen kontakt heter {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Vilken? Ange dess nummer, som {command} visar."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Vilka? Skicka {command} först, för deras nummer."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Det finns ingen {n} i {command}."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} finns inte längre: borttagen eller ändrad sedan dess."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Borttaget: {what}"

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
"✏️ Ändringen körs inte: boten har startat om sedan meddelandet den ändrar, så "
"den kan inte veta vad det gjorde. Skicka det som ett nytt meddelande i "
"stället."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: undoing what the message it edits did failed. Send it "
"as a new message instead."
msgstr ""
"✏️ Ändringen körs inte: det gick inte att ångra vad meddelandet den ändrar "
"gjorde. Skicka det som ett nytt meddelande i stället."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ En ändring av {command} körs inte, eftersom det den gjorde inte går att "
"ångra. Skicka det som ett nytt meddelande i stället."

#: nejomibot/contacts.py
msgid "Send: /contacts add <phone number, ID or name> <their name>"
msgstr "Skicka: /kontakter add <telefonnummer, ID eller namn> <deras namn>"

#: nejomibot/contacts.py
msgid ""
"Compare their safety number here with the one on their phone, then send: /"
"trust <name, phone number or ID> <safety number>"
msgstr ""
"Jämför säkerhetsnumret här med det i deras telefon och skicka sedan: /trust "
"<namn, telefonnummer eller ID> <säkerhetsnummer>"

#: nejomibot/contacts.py nejomibot/health.py nejomibot/status.py
msgid "unknown"
msgstr "okänd"

#: nejomibot/contacts.py
msgid "No safety number yet"
msgstr "Inget säkerhetsnummer ännu"

#: nejomibot/contacts.py
msgid "✅ Verified"
msgstr "✅ Verifierad"

#: nejomibot/contacts.py
msgid "❌ Untrusted: safety number changed"
msgstr "❌ Ej betrodd: säkerhetsnumret har ändrats"

#: nejomibot/contacts.py
msgid "⚪ Not verified"
msgstr "⚪ Inte verifierad"

#: nejomibot/contacts.py
#, python-brace-format
msgid ", key from {day}"
msgstr ", nyckel från {day}"

#: nejomibot/contacts.py
msgid "phone number not shared"
msgstr "telefonnumret delas inte"

#: nejomibot/contacts.py
msgid "🚫 blocked"
msgstr "🚫 blockerad"

#: nejomibot/contacts.py
#, python-brace-format
msgid "In {groups}"
msgstr "I {groups}"

#: nejomibot/contacts.py
#, python-brace-format
msgid "{count} safety number: {verified} verified, {untrusted} untrusted."
msgid_plural ""
"{count} safety numbers: {verified} verified, {untrusted} untrusted."
msgstr[0] ""
"{count} säkerhetsnummer: {verified} verifierade, {untrusted} ej betrodda."
msgstr[1] ""
"{count} säkerhetsnummer: {verified} verifierade, {untrusted} ej betrodda."

#: nejomibot/contacts.py
msgid "Who the bot knows"
msgstr "Vilka boten känner till"

#: nejomibot/contacts.py
msgid "Contacts"
msgstr "Kontakter"

#: nejomibot/contacts.py
msgid "Other known recipients"
msgstr "Andra kända mottagare"

#: nejomibot/contacts.py
msgid "Only a safety number"
msgstr "Bara ett säkerhetsnummer"

#: nejomibot/contacts.py
msgid ""
"/contacts <who> shows one, with their safety number to compare with their "
"phone before /trust."
msgstr ""
"/kontakter <vem> visar en, med säkerhetsnumret att jämföra med deras telefon "
"före /verifiera."

#: nejomibot/contacts.py
#, python-brace-format
msgid "{who} could be any of {count}, use their ID: {ids}"
msgstr "{who} kan syfta på {count}, använd ID: {ids}"

#: nejomibot/contacts.py
#, python-brace-format
msgid "No safety number for {name} yet."
msgstr "Inget säkerhetsnummer för {name} ännu."

#: nejomibot/contacts.py
#, python-brace-format
msgid ""
"❌ That isn't the safety number for {name}, so it's not verified. If theirs "
"really is different, they may have reinstalled Signal, or it may not be them."
msgstr ""
"❌ Det är inte säkerhetsnumret för {name}, så det verifieras inte. Om deras "
"verkligen är ett annat kan de ha installerat om Signal, eller så är det inte "
"de."

#: nejomibot/contacts.py
#, python-brace-format
msgid "✅ {name} is already verified."
msgstr "✅ {name} är redan verifierad."

#: nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Inget telefonnummer eller ID för {name}."

#: nejomibot/contacts.py
#, python-brace-format
msgid "✅ {name} verified."
msgstr "✅ {name} verifierad."

#: nejomibot/contacts.py
#, python-brace-format
msgid "✏️ Renamed {was} to {name} in the contacts."
msgstr "✏️ {was} heter nu {name} i kontakterna."

#: nejomibot/contacts.py
#, python-brace-format
msgid "📇 Added {was} to the contacts, as {name}."
msgstr "📇 La till {was} i kontakterna, som {name}."

#: nejomibot/delete.py
#, python-brace-format
msgid "Nothing left to delete here since the bot started, at {time}."
msgstr "Inget kvar att radera här sedan boten startade, {time}."

#: nejomibot/delete.py
msgid ""
"Nothing left to delete here from the last day: Signal only deletes messages "
"for everyone within a day."
msgstr ""
"Inget kvar att radera här från det senaste dygnet: Signal raderar bara "
"meddelanden för alla inom ett dygn."

#: nejomibot/delete.py
#, python-brace-format
msgid "The bot has sent nothing since it started, at {time}."
msgstr "Boten har inte skickat något sedan den startade, {time}."

#: nejomibot/delete.py
msgid ""
"The bot has sent nothing in the last day, and Signal only deletes messages "
"for everyone within a day."
msgstr ""
"Boten har inte skickat något det senaste dygnet, och Signal raderar bara "
"meddelanden för alla inom ett dygn."

#: nejomibot/delete.py
msgid "The bot's latest messages, newest first:"
msgstr "Botens senaste meddelanden, nyaste först:"

#: nejomibot/delete.py
msgid "/delete <n> deletes one for everyone; /delete 2,5,11 several."
msgstr "/radera <n> raderar ett för alla; /radera 2,5,11 flera."

#: nejomibot/delete.py
msgid "Which ones? Send /delete list first, for their numbers."
msgstr "Vilka? Skicka /radera list först, för deras nummer."

#: nejomibot/delete.py
#, python-brace-format
msgid "There's no message {n}: /delete list numbers them."
msgstr "Det finns inget meddelande {n}: /radera list numrerar dem."

#: nejomibot/delete.py
#, python-brace-format
msgid "Message {n} is gone already: deleted, or too old for Signal to delete."
msgstr ""
"Meddelande {n} är redan borta: raderat, eller för gammalt för Signal att "
"radera."

#: nejomibot/delete.py
#, python-brace-format
msgid "Not tried after that: {numbers}"
msgstr "Inte försökta efter det: {numbers}"

#: nejomibot/delete.py
msgid "Deleted"
msgstr "Raderat"

#: nejomibot/delete.py
msgid "/delete: delete the bot's latest message here, for everyone"
msgstr "/radera: radera botens senaste meddelande här, för alla"

#: nejomibot/delete.py
msgid "/delete list: its latest messages, wherever it sent them"
msgstr "/radera list: botens senaste meddelanden, var den än skickade dem"

#: nejomibot/delete.py
msgid "/delete <n>: delete one of those for everyone; /delete 2,5,11 several"
msgstr "/radera <n>: radera ett av dem för alla; /radera 2,5,11 flera"

#: nejomibot/fortune.py
msgid "Fortune libraries:"
msgstr "Spådomsbibliotek:"

#: nejomibot/fortune.py
msgid "No fortunes found."
msgstr "Hittade inga spådomar."

#: nejomibot/fortune.py
msgid "Unknown fortune library. Use /fortune list to see the names."
msgstr "Okänt spådomsbibliotek. Skicka /fortune list för att se namnen."

#: nejomibot/greeting.py
msgid "Hi, I'm a bot."
msgstr "Hej, jag är en bot."

#: nejomibot/greeting.py
#, python-brace-format
msgid "Hi, I'm {name}, a bot."
msgstr "Hej, jag är {name}, en bot."

#: nejomibot/greeting.py
#, python-brace-format
msgid "Try {help} for a list of commands."
msgstr "Prova {help} för en lista med kommandon."

#: nejomibot/greeting.py
#, python-brace-format
msgid "Contact {admin} for more information."
msgstr "Kontakta {admin} för mer information."

#: nejomibot/greeting.py
msgid "Contact the bot's admin for more information."
msgstr "Kontakta botens admin för mer information."

#: nejomibot/health.py
#, python-brace-format
msgid "{detail}, in {seconds} s"
msgstr "{detail}, på {seconds} s"

#: nejomibot/health.py
msgid "timed out"
msgstr "svarade inte i tid"

#: nejomibot/health.py nejomibot/status.py
msgid "Bot"
msgstr "Bot"

#: nejomibot/health.py
msgid "still starting: signalbot waits for signal-cli-rest-api and the account"
msgstr ""
"startar fortfarande: signalbot väntar på signal-cli-rest-api och kontot"

#: nejomibot/health.py
#, python-brace-format
msgid "{count} message waiting to be sent, the first for {duration}"
msgid_plural "{count} messages waiting to be sent, the first for {duration}"
msgstr[0] "{count} meddelande har väntat på att skickas i {duration}"
msgstr[1] "{count} meddelanden väntar på att skickas, det första i {duration}"

#: nejomibot/health.py
msgid "Signal rate-limits the bot: signal-account.sh rate-limit lifts it"
msgstr "Signal begränsar boten: signal-account.sh rate-limit häver det"

#: nejomibot/health.py
msgid "running"
msgstr "igång"

#: nejomibot/health.py
#, python-brace-format
msgid "version {version} in {mode} mode, not json-rpc"
msgstr "version {version} i läget {mode}, inte json-rpc"

#: nejomibot/health.py
#, python-brace-format
msgid "version {version} is too old: the bot needs a later one"
msgstr "version {version} är för gammal: boten behöver en senare"

#: nejomibot/health.py
#, python-brace-format
msgid "version {version}"
msgstr "version {version}"

#: nejomibot/health.py
#, python-brace-format
msgid "the account has {count} device"
msgid_plural "the account has {count} devices"
msgstr[0] "kontot har {count} enhet"
msgstr[1] "kontot har {count} enheter"

#: nejomibot/health.py
msgid "Signal"
msgstr "Signal"

#: nejomibot/health.py
