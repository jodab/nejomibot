"<n> – a number from /allowed, /admins, /timers, /delete list, /incoming, /"
"birthdays or /namedays"
msgstr ""
"<n> – eine Nummer aus /erlaubt, /admins, /timers, /löschen liste, /eingang, /"
"geburtstage oder /namenstage"

#: nejomibot/help.py
#, python-brace-format
msgid ""
"<when> – 08:00 · mon-fri 07:30 · {date} 15:00 · tomorrow 08:00 · every 2h, "
"in {zone} time"
msgstr ""
"<wann> – 08:00 · mo-fr 07:30 · {date} 15:00 · morgen 08:00 · jede 2h, in der "
"Zeit von {zone}"

#: nejomibot/help.py
msgid ""
"<chats> – numbers from /chats, like 1,2; a timer without them posts to you"
msgstr ""
"<chats> – Nummern aus /chats, wie 1,2; ein Timer ohne sie postet an dich"

#: nejomibot/help.py
msgid ""
"<date> – 1990-03-14, or 03-14 without the year; for someone not on Signal, "
"<who> is a name, shown in <chats>, or in every group"
msgstr ""
"<datum> – 1990-03-14, oder 03-14 ohne Jahr; für jemanden ohne Signal ist "
"<wer> ein Name, angezeigt in <chats> oder in jeder Gruppe"

#: nejomibot/help.py
msgid ""
"<parts> – text and commands, separated by ;, or by + for one message, e.g. "
"Good morning! /today + /weather; /uniquephoto"
msgstr ""
"<teile> – Text und Befehle, getrennt durch ; oder durch + für eine "
"Nachricht, z. B. Guten Morgen! /heute + /wetter; /neuesfoto"

#: nejomibot/help.py
msgid ""
"<album> – one of /albums, by name; /album takes a <date> with its year, or - "
"for none of its own, and shortcuts as /alice alice, or - for none"
msgstr ""
"<album> – eines aus /alben, über den Namen; /album nimmt ein <datum> mit "
"Jahr, oder - für keines, und Kürzel wie /alice alice, oder - für keine"

#: nejomibot/help.py
msgid "remove – after /about, /avatar or /username, takes it away"
msgstr "entfernen – nach /über, /profilbild oder /benutzername entfernt es"

#: nejomibot/help.py
msgid ""
"<language> – sv, or Svenska, its own name; /language <chats> <language> "
"gives those chats of /chats it, /admin add <who> <language> a new admin, and "
"a group's is an admin's to change"
msgstr ""
"<sprache> – de, oder Deutsch, ihr eigener Name; /sprache <chats> <sprache> "
"gibt sie diesen Chats aus /chats, /admin hinzufügen <wer> <sprache> einem "
"neuen Admin, und die einer Gruppe ändert ein Admin"

