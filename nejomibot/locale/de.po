msgstr "das Profil des Bots"

#: nejomibot/help.py
msgid "the bot's name"
msgstr "der Name des Bots"

#: nejomibot/help.py
msgid "the bot's About text"
msgstr "der Über-Text des Bots"

#: nejomibot/help.py
