#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} Album"
msgstr[1] "📚 {count} Alben"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Keine Alben: Jeder Ordner in der Fotobibliothek ist eins."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} Foto in keinem Album"
msgstr[1] "📷 {count} Fotos in keinem Album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <album>: das Album. /album <album> 2019-06-15: das Geburtsdatum, ab "
"dem die Bildunterschriften ein Alter zählen; /album <album> -: keines. /"
"album <album> kürzel /alice: andere Namen für /foto <album>; /album <album> "
"kürzel -: keine. /alben listet die Alben auf."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Geboren {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Kein Geburtsdatum, daher zeigen die Bildunterschriften kein Alter"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Kürzel: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Keine Kürzel"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr ""
"✅ {album}: geboren {day}, daher zeigen die Bildunterschriften das Alter."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} hat kein Geburtsdatum."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr ""
"✅ {album}: kein Geburtsdatum, daher zeigen die Bildunterschriften kein "
"Alter."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} ist bereits ein Kürzel für {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} hat keine Kürzel."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: keine Kürzel."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Ein Album hat höchstens {count} Kürzel."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Kürzel für /foto {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} ist kein Datum wie 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Sende /erlauben und wen: eine Telefonnummer, Signal-ID oder Gruppen-ID, den "
"Namen einer Gruppe, in der der Bot ist, oder jemanden aus /kontakte, über "
"die Nummer dort oder den Namen."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Sende /verbieten und wen: die Nummer in /erlaubt, die Telefonnummer, Signal-"
"ID oder Gruppen-ID oder den Namen."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr "{who} ist Admin und darf jeden Befehl verwenden: siehe /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(der Bot ist nicht darin)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Wer die Alltagsbefehle verwenden darf ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Die Admins dürfen jeden Befehl verwenden: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/erlauben <wer> fügt jemanden hinzu, /verbieten <n> entfernt jemanden."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Keine Telefonnummer oder ID für {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Keine Person und keine Gruppe heißt {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} könnte jeder von {count} sein, gib die ID an: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} darf die Alltagsbefehle bereits verwenden."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} darf jetzt die Alltagsbefehle verwenden."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Alle in {name} dürfen dort jetzt die Alltagsbefehle verwenden."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr ""
"Der Bot ist nicht in der Gruppe: Er antwortet dort, sobald er hinzugefügt "
"wurde."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "In {command} gibt es keine {n}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} ist nicht in {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} könnte jeder von {count} in {command} sein: Gib die Nummer an."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Timer {timers} postet dort weiterhin: siehe /timers."
msgstr[1] "Die Timer {timers} posten dort weiterhin: siehe /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Niemand in {name} darf dort jetzt noch die Alltagsbefehle verwenden."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} darf die Alltagsbefehle nicht mehr verwenden."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Die Person ist Admin und darf sie daher weiter verwenden."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Alles Gute zum Namenstag, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} wird heute {age}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Alles Gute zum Geburtstag, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "jede Gruppe"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Hier keine Geburtstage."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} Geburtstag"
msgstr[1] "🎂 {count} Geburtstage"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Hier keine Namenstage."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} Namenstag"
msgstr[1] "🌸 {count} Namenstage"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(wird {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr ""
"Geburtstage und Namenstage erscheinen in Gruppen, für die Mitglieder dort."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/geburtstag hinzufügen <datum> [<chats>] <wer>: ein Geburtstag, z. B."

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr ""
"/geburtstag hinzufügen 1990-03-14 Alice: ein Kontakt, in dessen Gruppen"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/geburtstag hinzufügen 03-14 1,2 Oma: jemand ohne Signal, in den Chats 1 und "
"2 aus /chats; ohne sie in jeder Gruppe"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr ""
"/geburtstag entfernen <n>: einen entfernen, über seine Nummer in /geburtstage"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr "/namenstag hinzufügen <datum> [<chats>] <wer>: ein Namenstag, z. B."

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr "/namenstag hinzufügen 08-08 Alice: ein Kontakt, in dessen Gruppen"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/namenstag hinzufügen 08-08 1,2 Oma: jemand ohne Signal, in den Chats 1 und "
"2 aus /chats; ohne sie in jeder Gruppe"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr ""
"/namenstag entfernen <n>: einen entfernen, über seine Nummer in /namenstage"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Niemand namens {who} in /kontakte."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Speichere {who} zuerst als Kontakt, unter dem Namen, der erscheinen soll: /"
"kontakte hinzufügen {who} <name>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} ist kein Tag: Gib ihn als 1990-03-14 oder 03-14 an."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "Ein Namenstag hat kein Jahr: Gib ihn als 08-08 an."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} liegt noch in der Zukunft."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Ein Name hat höchstens {count} Zeichen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} ist keine Gruppe: Geburtstage und Namenstage erscheinen nur in "
"Gruppen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} ist an diesem Tag bereits eingetragen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr ""
"Es gibt bereits {count} Geburtstage und Namenstage: Entferne zuerst einen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Hinzugefügt: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Geändert: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 In den Gruppen, in denen {name} ist"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 In jeder Gruppe: Kein Kontakt heißt {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Nur in einigen Gruppen: füge ihn noch einmal mit ihren Nummern aus /chats "
"hinzu: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Welcher? Gib die Nummer an, wie {command} sie zeigt."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Welche? Sende zuerst {command}, für die Nummern."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} gibt es nicht mehr: inzwischen entfernt oder geändert."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Entfernt: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Der Bot beantwortet höchstens {count} Befehl pro Person in {period}. Er "
"antwortet dir wieder in {wait}."
msgstr[1] ""
"⏳ Der Bot beantwortet höchstens {count} Befehle pro Person in {period}. Er "
"antwortet dir wieder in {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "Ein Kürzel darf kein | und kein ; enthalten."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr "{name} ist ein Alias in der Konfiguration: Entferne es zuerst dort."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} ist bereits ein Befehl."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ Eine Bearbeitung von {command} wird nicht ausgeführt, da sich seine "
"Wirkung nicht rückgängig machen lässt. Sende es stattdessen als neue "
"Nachricht."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
