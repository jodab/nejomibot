#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Sende /erlauben und wen: eine Telefonnummer, Signal-ID oder Gruppen-ID, den "
"Namen einer Gruppe, in der der Bot ist, oder jemanden aus /kontakte, über "
"die Nummer dort oder den Namen."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Sende /verbieten und wen: die Nummer in /erlaubt, die Telefonnummer, Signal-"
"ID oder Gruppen-ID oder den Namen."

#: nejomibot/allowed.py
#, python-brace-format
