#: nejomibot/admins.py
msgid ""
"/admin add <who> [<language>]: make someone an admin, by their number in /"
"contacts, phone number, Signal ID or name, and send them a welcome; with a "
"language, such as sv, the bot speaks it with them"
msgstr ""
"/admin legg til <hvem> [<språk>]: gjør noen til administrator, med nummeret "
"i /kontakter, telefonnummer, Signal-ID eller navn, og send en "
"velkomstmelding; med et språk, for eksempel nb, snakker boten det med "
"vedkommende"

#: nejomibot/admins.py
msgid "/admin remove <n>: no longer, by their number in /admins"
msgstr "/admin fjern <n>: ikke lenger, med nummeret i /admins"

#: nejomibot/admins.py
msgid "Only the admins in the config add and remove admins."
msgstr ""
"Bare administratorene i konfigurasjonen legger til og fjerner "
"administratorer."

#: nejomibot/admins.py
#, python-brace-format
msgid "Admins ({count}):"
msgstr "Administratorer ({count}):"

#: nejomibot/admins.py
msgid "in the config"
msgstr "i konfigurasjonen"

#: nejomibot/admins.py
msgid ""
"/admin add <who> adds one, /admin remove <n> removes one; only the admins in "
"the config can."
msgstr ""
"/admin legg til <hvem> legger til én, /admin fjern <n> fjerner én; bare "
"administratorene i konfigurasjonen kan gjøre det."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is a group: admins are people."
msgstr "{name} er en gruppe: administratorer er personer."

#: nejomibot/admins.py
msgid "Welcome!"
msgstr "Velkommen!"

#: nejomibot/admins.py
#, python-brace-format
msgid "{admin} has made you an admin of this bot."
msgstr "{admin} har gjort deg til administrator for denne boten."

#: nejomibot/admins.py
msgid "You're an admin of this bot now."
msgstr "Du er nå administrator for denne boten."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"Here, in a direct chat with the bot, you may use every command: {help} lists "
"them all. A few to start with:"
msgstr ""
"Her, i en direkte chat med boten, kan du bruke alle kommandoer: {help} viser "
"dem alle. Noen å begynne med:"

#: nejomibot/admins.py
msgid "Thank you for helping look after the bot."
msgstr "Takk for at du hjelper til med å ta vare på boten."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome went to them, in {language}."
msgstr "En velkomstmelding ble sendt til vedkommende, på {language}."

#: nejomibot/admins.py
#, python-brace-format
msgid "A welcome to them, in {language}, waits to be sent."
msgstr ""
"En velkomstmelding til vedkommende, på {language}, venter på å bli sendt."

#: nejomibot/admins.py
msgid "The welcome to them couldn't be sent."
msgstr "Velkomstmeldingen til vedkommende kunne ikke sendes."

#: nejomibot/admins.py nejomibot/allowed.py
msgid "That's the bot itself."
msgstr "Det er boten selv."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin in the config already."
msgstr "{name} er allerede administrator i konfigurasjonen."

#: nejomibot/admins.py
#, python-brace-format
msgid ""
"The bot doesn't know the Signal ID of {name} yet, by which admins are kept: "
"once they've written to it, it does."
msgstr ""
"Boten kjenner ennå ikke Signal-ID-en til {name}, som administratorer lagres "
"med: når vedkommende har skrevet til den, gjør den det."

#: nejomibot/admins.py
#, python-brace-format
msgid "{name} is an admin already."
msgstr "{name} er allerede administrator."

#: nejomibot/admins.py nejomibot/allowed.py
#, python-brace-format
msgid "The list is full: {count} at most."
msgstr "Listen er full: høyst {count}."

#: nejomibot/admins.py
#, python-brace-format
msgid "👑 {name} is an admin now, and may use every command."
msgstr "👑 {name} er nå administrator og kan bruke alle kommandoer."

#: nejomibot/admins.py
#, python-brace-format
msgid "The bot speaks {language} with them from now on."
msgstr "Boten snakker {language} med vedkommende fra nå av."

#: nejomibot/admins.py
#, python-brace-format
msgid "{who} is an admin in the config, which no command changes."
msgstr "{who} er administrator i konfigurasjonen, noe ingen kommando endrer."

#: nejomibot/admins.py
#, python-brace-format
msgid "🗑️ {name} is no longer an admin."
msgstr "🗑️ {name} er ikke lenger administrator."

#: nejomibot/admins.py
msgid "They're on /allowed, so may still use the everyday commands."
msgstr ""
"Vedkommende står i /tillatte og kan fortsatt bruke hverdagskommandoene."

#: nejomibot/albums.py nejomibot/status.py
#, python-brace-format
msgid "{count} photo"
msgid_plural "{count} photos"
msgstr[0] "{count} bilde"
msgstr[1] "{count} bilder"

#: nejomibot/albums.py
#, python-brace-format
msgid "📚 {count} album"
msgid_plural "📚 {count} albums"
msgstr[0] "📚 {count} album"
msgstr[1] "📚 {count} album"

#: nejomibot/albums.py
msgid "📚 No albums: each folder in the photo library is one."
msgstr "📚 Ingen album: hver mappe i bildearkivet er ett."

#: nejomibot/albums.py
#, python-brace-format
msgid "📷 {count} photo in no album"
msgid_plural "📷 {count} photos in no album"
msgstr[0] "📷 {count} bilde uten album"
msgstr[1] "📷 {count} bilder uten album"

#: nejomibot/albums.py
msgid ""
"/album <album>: the album. /album <album> 2019-06-15: the birth date its "
"captions count an age from; /album <album> -: none. /album <album> "
"shortcuts /alice: other names for /photo <album>; /album <album> shortcuts "
"-: none. /albums lists the albums."
msgstr ""
"/album <album>: albumet. /album <album> 2019-06-15: fødselsdatoen "
"bildetekstene regner en alder fra; /album <album> -: ingen. /album <album> "
"snarveier /alice: andre navn for /bilde <album>; /album <album> snarveier -: "
"ingen. /albums viser albumene."

#: nejomibot/albums.py
#, python-brace-format
msgid "Born {day}"
msgstr "Født {day}"

#: nejomibot/albums.py
msgid "No birth date, so its captions show no age"
msgstr "Ingen fødselsdato, så bildetekstene viser ingen alder"

#: nejomibot/albums.py
#, python-brace-format
msgid "Shortcuts: {shortcuts}"
msgstr "Snarveier: {shortcuts}"

#: nejomibot/albums.py
msgid "No shortcuts"
msgstr "Ingen snarveier"

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: born {day}, so its captions show the age."
msgstr "✅ {album}: født {day}, så bildetekstene viser alderen."

#: nejomibot/albums.py
#, python-brace-format
msgid "{album} has no birth date."
msgstr "{album} har ingen fødselsdato."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ {album}: no birth date, so its captions show no age."
msgstr "✅ {album}: ingen fødselsdato, så bildetekstene viser ingen alder."

#: nejomibot/albums.py nejomibot/commands.py
#, python-brace-format
msgid "{name} is a shortcut for {album} already."
msgstr "{name} er allerede en snarvei for {album}."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "{album} has no shortcuts."
msgstr "{album} har ingen snarveier."

#: nejomibot/albums.py nejomibot/specials.py
#, python-brace-format
msgid "✅ {album}: no shortcuts."
msgstr "✅ {album}: ingen snarveier."

#: nejomibot/albums.py
#, python-brace-format
msgid "An album has at most {count} shortcuts."
msgstr "Et album har høyst {count} snarveier."

#: nejomibot/albums.py
#, python-brace-format
msgid "✅ Shortcuts for /photo {album}: {shortcuts}."
msgstr "✅ Snarveier for /bilde {album}: {shortcuts}."

#: nejomibot/albums.py
#, python-brace-format
msgid "{text} isn't a date, as 2019-06-15."
msgstr "{text} er ikke en dato som 2019-06-15."

#: nejomibot/allowed.py
msgid ""
"Send /allow and who: a phone number, Signal ID or group ID, the name of a "
"group the bot is in, or someone in /contacts, by their number there or name."
msgstr ""
"Send /tillat og hvem: et telefonnummer, en Signal-ID eller gruppe-ID, navnet "
"på en gruppe boten er med i, eller noen i /kontakter, med nummeret der eller "
"navnet."

#: nejomibot/allowed.py
msgid ""
"Send /disallow and who: their number in /allowed, phone number, Signal ID or "
"group ID, or name."
msgstr ""
"Send /avvis og hvem: nummeret i /tillatte, telefonnummer, Signal-ID eller "
"gruppe-ID, eller navn."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} is an admin, and may use every command: see /admins."
msgstr "{who} er administrator og kan bruke alle kommandoer: se /admins."

#: nejomibot/allowed.py
msgid "(the bot isn't in it)"
msgstr "(boten er ikke med i den)"

#: nejomibot/allowed.py
#, python-brace-format
msgid "Who may use the everyday commands ({count}):"
msgstr "Hvem som kan bruke hverdagskommandoene ({count}):"

#: nejomibot/allowed.py
#, python-brace-format
msgid "The admins may use every command: {admins}"
msgstr "Administratorene kan bruke alle kommandoer: {admins}"

#: nejomibot/allowed.py
msgid "/allow <who> adds one, /disallow <n> removes one."
msgstr "/tillat <hvem> legger til noen, /avvis <n> fjerner noen."

#: nejomibot/allowed.py nejomibot/contacts.py
#, python-brace-format
msgid "No phone number or ID for {name}."
msgstr "Ikke noe telefonnummer eller ID for {name}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Nobody and no group is called {who}."
msgstr "Ingen person og ingen gruppe heter {who}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count}, give their ID: {ids}"
msgstr "{who} kan være hvem som helst av {count}, oppgi ID-en: {ids}"

#: nejomibot/allowed.py
#, python-brace-format
msgid "{name} may use the everyday commands already."
msgstr "{name} kan allerede bruke hverdagskommandoene."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ {name} may use the everyday commands now."
msgstr "✅ {name} kan nå bruke hverdagskommandoene."

#: nejomibot/allowed.py
#, python-brace-format
msgid "✅ Everyone in {name} may use the everyday commands there now."
msgstr "✅ Alle i {name} kan nå bruke hverdagskommandoene der."

#: nejomibot/allowed.py
msgid "The bot isn't in the group: it answers there once added."
msgstr "Boten er ikke med i gruppen: den svarer der når den er lagt til."

#: nejomibot/allowed.py nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "There's no {n} in {command}."
msgstr "Det finnes ingen {n} i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} isn't in {command}."
msgstr "{who} er ikke i {command}."

#: nejomibot/allowed.py
#, python-brace-format
msgid "{who} could be any of {count} in {command}: give its number."
msgstr "{who} kan være hvem som helst av {count} i {command}: oppgi nummeret."

#: nejomibot/allowed.py
#, python-brace-format
msgid "Timer {timers} still posts there: see /timers."
msgid_plural "Timers {timers} still post there: see /timers."
msgstr[0] "Timer {timers} poster fortsatt der: se /timers."
msgstr[1] "Timerne {timers} poster fortsatt der: se /timers."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ Nobody in {name} may use the everyday commands there now."
msgstr "🗑️ Ingen i {name} kan nå bruke hverdagskommandoene der."

#: nejomibot/allowed.py
#, python-brace-format
msgid "🗑️ {name} may no longer use the everyday commands."
msgstr "🗑️ {name} kan ikke lenger bruke hverdagskommandoene."

#: nejomibot/allowed.py
msgid "They're an admin, so may still use them."
msgstr "Vedkommende er administrator og kan derfor fortsatt bruke dem."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 Happy name day, {name}!"
msgstr "🌸 Gratulerer med navnedagen, {name}!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {name} turns {age} today!"
msgstr "🎂 {name} fyller {age} i dag!"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 Happy birthday, {name}!"
msgstr "🎂 Gratulerer med dagen, {name}!"

#: nejomibot/birthdays.py
msgid "every group"
msgstr "alle grupper"

#: nejomibot/birthdays.py
msgid "No birthdays here."
msgstr "Ingen bursdager her."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🎂 {count} birthday"
msgid_plural "🎂 {count} birthdays"
msgstr[0] "🎂 {count} bursdag"
msgstr[1] "🎂 {count} bursdager"

#: nejomibot/birthdays.py
msgid "No name days here."
msgstr "Ingen navnedager her."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🌸 {count} name day"
msgid_plural "🌸 {count} name days"
msgstr[0] "🌸 {count} navnedag"
msgstr[1] "🌸 {count} navnedager"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "(turns {age})"
msgstr "(fyller {age})"

#: nejomibot/birthdays.py
msgid "Birthdays and name days show in groups, for those in them."
msgstr "Bursdager og navnedager vises i grupper, for dem som er med i dem."

#: nejomibot/birthdays.py
msgid "/birthday add <date> [<chats>] <who>: a birthday, e.g."
msgstr "/bursdag legg til <dato> [<chatter>] <hvem>: en bursdag, for eksempel"

#: nejomibot/birthdays.py
msgid "/birthday add 1990-03-14 Alice: a contact, where they are"
msgstr ""
"/bursdag legg til 1990-03-14 Alice: en kontakt, i gruppene kontakten er med i"

#: nejomibot/birthdays.py
msgid ""
"/birthday add 03-14 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/bursdag legg til 03-14 1,2 Mormor: noen som ikke er på Signal, i chat 1 og "
"2 i /chats; uten dem, i alle grupper"

#: nejomibot/birthdays.py
msgid "/birthday remove <n>: remove one, by its number in /birthdays"
msgstr "/bursdag fjern <n>: fjern én, med nummeret i /bursdager"

#: nejomibot/birthdays.py
msgid "/nameday add <date> [<chats>] <who>: a name day, e.g."
msgstr ""
"/navnedag legg til <dato> [<chatter>] <hvem>: en navnedag, for eksempel"

#: nejomibot/birthdays.py
msgid "/nameday add 08-08 Alice: a contact, where they are"
msgstr ""
"/navnedag legg til 08-08 Alice: en kontakt, i gruppene kontakten er med i"

#: nejomibot/birthdays.py
msgid ""
"/nameday add 08-08 1,2 Grandma: someone not on Signal, in chats 1 and 2 of /"
"chats; without them, in every group"
msgstr ""
"/navnedag legg til 08-08 1,2 Mormor: noen som ikke er på Signal, i chat 1 og "
"2 i /chats; uten dem, i alle grupper"

#: nejomibot/birthdays.py
msgid "/nameday remove <n>: remove one, by its number in /namedays"
msgstr "/navnedag fjern <n>: fjern én, med nummeret i /navnedager"

#: nejomibot/birthdays.py nejomibot/contacts.py
#, python-brace-format
msgid "Nobody called {who} in /contacts."
msgstr "Ingen heter {who} i /kontakter."

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"Save {who} as a contact first, by the name to show: /contacts add {who} "
"<name>"
msgstr ""
"Lagre {who} som kontakt først, med navnet som skal vises: /kontakter legg "
"til {who} <navn>"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{text} isn't a day: give it as 1990-03-14, or 03-14."
msgstr "{text} er ikke en dag: oppgi den som 1990-03-14 eller 03-14."

#: nejomibot/birthdays.py
msgid "A name day has no year: give it as 08-08."
msgstr "En navnedag har ikke noe år: oppgi den som 08-08."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{day} is still to come."
msgstr "{day} har ikke kommet ennå."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "A name has at most {count} characters."
msgstr "Et navn har høyst {count} tegn."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is no group: they show in groups only."
msgstr ""
"{name} er ikke en gruppe: bursdager og navnedager vises bare i grupper."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{name} is there already, on that day."
msgstr "{name} er der allerede, på den dagen."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "There are {count} birthdays and name days already: remove one first."
msgstr "Det finnes allerede {count} bursdager og navnedager: fjern én først."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Added: {day} · {name}"
msgstr "✅ Lagt til: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "✅ Changed: {day} · {name}"
msgstr "✅ Endret: {day} · {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In the groups {name} is in"
msgstr "👥 I gruppene {name} er med i"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "👥 In every group: no contact is called {name}"
msgstr "👥 I alle grupper: ingen kontakt heter {name}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid ""
"For some groups only, add it again with their numbers from /chats: {example}"
msgstr ""
"Bare i noen grupper: legg den til igjen med numrene deres i /chats: {example}"

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which? Give its number, as {command} shows."
msgstr "Hvilken? Oppgi nummeret, slik {command} viser det."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "Which ones? Send {command} first, for their numbers."
msgstr "Hvilke? Send {command} først for å se numrene."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "{n} is gone already: removed or changed since."
msgstr "{n} finnes ikke lenger: fjernet eller endret siden."

#: nejomibot/birthdays.py
#, python-brace-format
msgid "🗑️ Removed: {what}"
msgstr "🗑️ Fjernet: {what}"

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"⏳ The bot answers each person at most {count} command in {period}. It "
"answers you again in {wait}."
msgid_plural ""
"⏳ The bot answers each person at most {count} commands in {period}. It "
"answers you again in {wait}."
msgstr[0] ""
"⏳ Boten svarer på høyst {count} kommando fra hver person på {period}. Den "
"svarer deg igjen om {wait}."
msgstr[1] ""
"⏳ Boten svarer på høyst {count} kommandoer fra hver person på {period}. Den "
"svarer deg igjen om {wait}."

#: nejomibot/commands.py
msgid "A shortcut can't have a | or a ;."
msgstr "En snarvei kan ikke inneholde | eller ;."

#: nejomibot/commands.py
#, python-brace-format
msgid "{name} is an alias in the config: take it out there first."
msgstr "{name} er et alias i konfigurasjonen: fjern det der først."

#: nejomibot/commands.py nejomibot/specials.py
#, python-brace-format
msgid "{name} is a command already."
msgstr "{name} er allerede en kommando."

#: nejomibot/commands.py
#, python-brace-format
msgid ""
"✏️ An edit of {command} isn't run, as what it did can't be undone. Send it as "
"a new message instead."
msgstr ""
"✏️ En redigering av {command} kjøres ikke, siden det den gjorde ikke kan "
"angres. Send den som en ny melding i stedet."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: the bot has started again since the message it edits, "
"so it can't tell what that did. Send it as a new message instead."
msgstr ""
"✏️ Den redigeringen kjøres ikke: boten har startet på nytt siden meldingen "
"den redigerer, så den kan ikke vite hva den gjorde. Send den som en ny "
"melding i stedet."

#: nejomibot/commands.py
msgid ""
"✏️ That edit isn't run: undoing what the message it edits did failed. Send it "
"as a new message instead."
msgstr ""
