#: nejomibot/timers.py
#, python-brace-format
msgid ""
"<when> is a time (08:00, or 08:00,18:30), days and a time (mon-fri 07:30, "
"sat,sun 10:00), a date and a time for once ({date} 15:00, tomorrow 08:00), "
"or every 2h or 30m"
msgstr ""
"<når> er et klokkeslett (08:00, eller 08:00,18:30), dager og et klokkeslett "
"(man-fre 07:30, lør,søn 10:00), en dato og et klokkeslett for én gang "
"({date} 15:00, imorgen 08:00), eller hver 2h eller 30m"

#: nejomibot/timers.py
msgid "/chats: where timers can post, numbered"
msgstr "/chats: hvor timere kan poste, nummerert"

#: nejomibot/timers.py
msgid "/timers: the timers"
msgstr "/timers: timerne"

#: nejomibot/timers.py
msgid "/timer add <when> [<chats>] <commands>: a new one, e.g."
msgstr "/timer legg til <når> [<chatter>] <kommandoer>: en ny, for eksempel"

#: nejomibot/timers.py
msgid "/timer add mon-fri 07:30 1,2 /weather; /photo"
msgstr "/timer legg til man-fre 07:30 1,2 /vær; /bilde"

#: nejomibot/timers.py
msgid "The chats are numbers from /chats; without them, it posts to you."
msgstr "Chattene er numre fra /chats; uten dem poster den til deg."

#: nejomibot/timers.py
msgid "/timer remove <n>, /timer run <n>: remove one, or run it now"
msgstr "/timer fjern <n>, /timer kjør <n>: fjern én, eller kjør den nå"

