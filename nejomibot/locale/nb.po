msgstr ""
"En timer på en dato kjøres én gang: gi den ett klokkeslett og ingen dager."

#: nejomibot/timers.py
#, python-brace-format
msgid "Timers, specials and /run can't run {command}."
msgstr "Timere, spesialkommandoer og /kjør kan ikke kjøre {command}."

#: nejomibot/timers.py
