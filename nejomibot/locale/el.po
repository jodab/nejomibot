msgstr "Το {command} δεν είναι εντολή που γνωρίζει το bot."

#: nejomibot/timers.py
#, python-brace-format
msgid "Commands start with . or /, unlike {command}."
msgstr "Οι εντολές ξεκινούν με . ή /, σε αντίθεση με το {command}."

