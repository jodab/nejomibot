#: nejomibot/specials.py
#, python-brace-format
msgid ""
"✅ Everyone allowed may use {name} now, in groups too, and /help lists it."
msgstr ""
"✅ Όλοι οι επιτρεπόμενοι μπορούν πλέον να χρησιμοποιούν την ειδική εντολή "
"{name}, και σε ομάδες, και το /βοήθεια την αναφέρει."

