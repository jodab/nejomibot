msgstr "Έως {count} εντολές τη φορά."

#: nejomibot/timers.py
msgid "Which commands?"
msgstr "Ποιες εντολές;"

#: nejomibot/timers.py
msgid "For /timer add, e.g. /timer add 08:00 1,2 /weather; /photo"
msgstr ""
"Για το /timer πρόσθεσε, π.χ. /timer πρόσθεσε 08:00 1,2 /καιρός; /φωτογραφία"

