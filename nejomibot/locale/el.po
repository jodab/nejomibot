msgstr "χθες"

#: nejomibot/account.py
msgid "primary"
msgstr "κύρια"

#: nejomibot/account.py
#, python-brace-format
msgid "(seen {day})"
msgstr "(τελευταία φορά {day})"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} contact"
msgid_plural "{count} contacts"
msgstr[0] "{count} επαφή"
msgstr[1] "{count} επαφές"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} known recipient"
msgid_plural "{count} known recipients"
msgstr[0] "{count} γνωστός παραλήπτης"
msgstr[1] "{count} γνωστοί παραλήπτες"

#: nejomibot/account.py nejomibot/status.py
#, python-brace-format
msgid "blocked: {who}"
msgstr "αποκλεισμένοι: {who}"

#: nejomibot/account.py
#, python-brace-format
msgid "Safety numbers: {trusted} trusted ({verified} verified)"
msgstr "Αριθμοί ασφαλείας: {trusted} εμπιστευμένοι ({verified} επαληθευμένοι)"

#: nejomibot/account.py
#, python-brace-format
msgid "{count} untrusted"
msgstr "{count} μη εμπιστευμένοι"

#: nejomibot/account.py
#, python-brace-format
