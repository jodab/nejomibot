#, python-brace-format
msgid "Removed {name}"
msgstr "Αφαιρέθηκε το {name}"

#: nejomibot/specials.py
#, python-brace-format
msgid "A special has at most {count} shortcuts."
msgstr "Μια ειδική εντολή έχει έως {count} συντομεύσεις."

#: nejomibot/specials.py
#, python-brace-format
msgid "✅ Shortcuts for {name}: {shortcuts}."
msgstr "✅ Συντομεύσεις για το {name}: {shortcuts}."

#: nejomibot/specials.py
#, python-brace-format
msgid "Everyone allowed may use {name} already."
msgstr "Η ειδική εντολή {name} είναι ήδη για όλους τους επιτρεπόμενους."

#: nejomibot/specials.py
#, python-brace-format
msgid "Only the admins may use {name} already."
msgstr "Η ειδική εντολή {name} είναι ήδη μόνο για τους διαχειριστές."

#: nejomibot/specials.py
#, python-brace-format
msgid "✅ Only the admins may use {name} now."
msgstr ""
"✅ Μόνο οι διαχειριστές μπορούν πλέον να χρησιμοποιούν την ειδική εντολή "
