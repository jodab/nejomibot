msgstr "Κάθε πόσο; Όπως κάθε 30m, κάθε 2h ή κάθε 1h30m."

#: nejomibot/timers.py
#, python-brace-format
msgid "Not more often than every {every}."
msgstr "Όχι συχνότερα από κάθε {every}."

