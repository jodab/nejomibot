msgstr "Λογαριασμός Signal"

#: nejomibot/status.py
msgid "Internet"
msgstr "Διαδίκτυο"

#: nejomibot/status.py
msgid "Container"
msgstr "Κοντέινερ"

#: nejomibot/status.py
msgid "Host"
msgstr "Υπολογιστής"

#: nejomibot/timers.py
#, python-brace-format
msgid ""
"<when> is a time (08:00, or 08:00,18:30), days and a time (mon-fri 07:30, "
"sat,sun 10:00), a date and a time for once ({date} 15:00, tomorrow 08:00), "
"or every 2h or 30m"
msgstr ""
"το <πότε> είναι ώρα (08:00, ή 08:00,18:30), μέρες και ώρα (δευ-παρ 07:30, "
"σαβ,κυρ 10:00), ημερομηνία και ώρα για μία φορά ({date} 15:00, αύριο 08:00), "
"ή κάθε 2h ή 30m"

#: nejomibot/timers.py
msgid "/chats: where timers can post, numbered"
msgstr "/chats: πού μπορούν να δημοσιεύουν οι χρονοδιακόπτες, αριθμημένα"

#: nejomibot/timers.py
msgid "/timers: the timers"
msgstr "/timers: οι χρονοδιακόπτες"

#: nejomibot/timers.py
msgid "/timer add <when> [<chats>] <commands>: a new one, e.g."
msgstr "/timer πρόσθεσε <πότε> [<συνομιλίες>] <εντολές>: νέος, π.χ."

#: nejomibot/timers.py
msgid "/timer add mon-fri 07:30 1,2 /weather; /photo"
msgstr "/timer πρόσθεσε δευ-παρ 07:30 1,2 /καιρός; /φωτογραφία"

#: nejomibot/timers.py
msgid "The chats are numbers from /chats; without them, it posts to you."
msgstr ""
"Οι συνομιλίες είναι αριθμοί από το /chats· χωρίς αυτούς, δημοσιεύει σε εσάς."

