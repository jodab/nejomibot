msgid "Avatar: yes"
msgstr "Εικόνα προφίλ: ναι"

#: nejomibot/profile.py
msgid "No avatar"
msgstr "Χωρίς εικόνα προφίλ"

#: nejomibot/profile.py
msgid "Change them with /name, /about, /avatar and /username."
msgstr "Αλλάξτε τα με /όνομα, /σχετικά, /εικόνα και /όνομαχρήστη."

#: nejomibot/publicip.py
msgid "not announced"
msgstr "δεν ανακοινώνεται"

#: nejomibot/publicip.py
#, python-brace-format
msgid "{family} none ({error})"
msgstr "{family} κανένα ({error})"

#: nejomibot/relay.py
msgid ""
"Send /msg <chats> <text>, e.g. /msg 1,2 Hello! The chats are numbers from /"
"chats."
msgstr ""
"Στείλτε /μήνυμα <συνομιλίες> <κείμενο>, π.χ. /μήνυμα 1,2 Γεια σας! Οι "
"συνομιλίες είναι αριθμοί από το /chats."

#: nejomibot/relay.py
msgid ""
"Send /run <chats> <commands>, e.g. /run 1 /weather; /photo. The chats are "
"numbers from /chats."
msgstr ""
"Στείλτε /εκτέλεση <συνομιλίες> <εντολές>, π.χ. /εκτέλεση 1 /καιρός; /"
"φωτογραφία. Οι συνομιλίες είναι αριθμοί από το /chats."

#: nejomibot/relay.py
#, python-brace-format
msgid "⏳ Not sent yet to {chats}: tried again for {hours} hours."
msgstr ""
"⏳ Δεν στάλθηκε ακόμη σε {chats}: θα επιχειρείται ξανά για {hours} ώρες."

#: nejomibot/relay.py
#, python-brace-format
msgid "⚠️ May not have reached {chats}."
msgstr "⚠️ Ίσως δεν έφτασε σε {chats}."

#: nejomibot/relay.py
#, python-brace-format
msgid "✉️ Sent to {chats}."
msgstr "✉️ Στάλθηκε σε {chats}."

#: nejomibot/relay.py
#, python-brace-format
msgid "▶️ Posted the answers to {chats}."
msgstr "▶️ Οι απαντήσεις δημοσιεύτηκαν σε {chats}."

#: nejomibot/reminders.py
msgid "/remind <when> <text>: a reminder here, e.g."
msgstr "/υπενθύμιση <πότε> <κείμενο>: μια υπενθύμιση εδώ, π.χ."

#: nejomibot/reminders.py
msgid "/remind tomorrow 08:00 Pick up Bob"
msgstr "/υπενθύμιση αύριο 08:00 Πάρε τον Bob"

#: nejomibot/reminders.py
#, python-brace-format
msgid ""
"<when> is a time (18:00), a day and a time (fri 17:00, tomorrow 08:00, "
"{date} 15:00), or how soon (30m, 2h, 1h30m), in {zone} time"
msgstr ""
"το <πότε> είναι ώρα (18:00), μέρα και ώρα (παρ 17:00, αύριο 08:00, {date} "
"15:00), ή σε πόσο (30m, 2h, 1h30m), σε ώρα {zone}"

#: nejomibot/reminders.py
msgid "/remind: the reminders here"
msgstr "/υπενθύμιση: οι υπενθυμίσεις εδώ"

#: nejomibot/reminders.py
msgid "/remind remove <n>: remove one"
msgstr "/υπενθύμιση αφαίρεσε <n>: αφαίρεση μίας"

#: nejomibot/reminders.py
msgid "No reminders here."
msgstr "Δεν υπάρχουν υπενθυμίσεις εδώ."

#: nejomibot/reminders.py
#, python-brace-format
msgid "🔔 {count} reminder here"
msgid_plural "🔔 {count} reminders here"
msgstr[0] "🔔 {count} υπενθύμιση εδώ"
msgstr[1] "🔔 {count} υπενθυμίσεις εδώ"

#: nejomibot/reminders.py
msgid "When?"
msgstr "Πότε;"

#: nejomibot/reminders.py
msgid "What should the reminder say?"
msgstr "Τι να λέει η υπενθύμιση;"

#: nejomibot/reminders.py nejomibot/timers.py
#, python-brace-format
msgid "{when} has already been."
msgstr "Το {when} έχει ήδη περάσει."

#: nejomibot/reminders.py
msgid "A reminder can be at most a year ahead."
msgstr "Μια υπενθύμιση μπορεί να είναι έως ένα χρόνο μπροστά."

#: nejomibot/reminders.py
#, python-brace-format
msgid "A reminder has at most {count} characters."
msgstr "Μια υπενθύμιση έχει έως {count} χαρακτήρες."

#: nejomibot/reminders.py
#, python-brace-format
msgid "There are {count} reminders here already: remove one first."
msgstr "Υπάρχουν ήδη {count} υπενθυμίσεις εδώ: αφαιρέστε πρώτα μία."

#: nejomibot/reminders.py nejomibot/timers.py
msgid "Added"
msgstr "Προστέθηκε"

#: nejomibot/reminders.py
msgid "Which reminder? Give its number, as /remind shows."
msgstr ""
"Ποια υπενθύμιση; Δώστε τον αριθμό της, όπως τον δείχνει το /υπενθύμιση."

#: nejomibot/reminders.py
#, python-brace-format
msgid "No reminder #{n} here."
msgstr "Δεν υπάρχει υπενθύμιση #{n} εδώ."

#: nejomibot/reminders.py nejomibot/timers.py
msgid "Removed"
msgstr "Αφαιρέθηκε"

#: nejomibot/reminders.py
#, python-brace-format
msgid "⏰ {text}"
msgstr "⏰ {text}"

#: nejomibot/specials.py
msgid "Give it a name: a word that starts with . or /, like /morning."
msgstr "Δώστε της όνομα: μια λέξη που ξεκινά με . ή /, όπως /πρωί."

#: nejomibot/specials.py
#, python-brace-format
msgid "{command} is a special of yours, and specials can't run each other."
msgstr ""
"Το {command} είναι δική σας ειδική εντολή, και οι ειδικές εντολές δεν "
"μπορούν να εκτελούν η μία την άλλη."

#: nejomibot/specials.py
msgid "What should it post?"
msgstr "Τι να δημοσιεύει;"

#: nejomibot/specials.py
#, python-brace-format
msgid "A special has at most {count} parts."
msgstr "Μια ειδική εντολή έχει έως {count} μέρη."

#: nejomibot/specials.py
#, python-brace-format
msgid ""
"⚠️ It runs admin commands: {commands}. Everyone allowed who uses it, in a "
"group too, now sees what they show, and has them do what they do; /special "
"admins {name} takes that back."
msgstr ""
"⚠️ Εκτελεί εντολές διαχειριστή: {commands}. Όποιος επιτρέπεται και τη "
"χρησιμοποιεί, και σε ομάδα, βλέπει πλέον ό,τι δείχνουν αυτές και τις βάζει "
"να κάνουν ό,τι κάνουν· το /special για διαχειριστές {name} το αναιρεί."

#: nejomibot/specials.py
msgid "/specials: commands of your own, of text and other commands"
msgstr "/specials: δικές σας εντολές, από κείμενο και άλλες εντολές"

#: nejomibot/specials.py
msgid "/special add <name> <parts>: a new one, or a change, e.g."
msgstr "/special πρόσθεσε <όνομα> <μέρη>: νέα, ή αλλαγή, π.χ."

#: nejomibot/specials.py
msgid "/special add /morning Good morning! /weather"
msgstr "/special πρόσθεσε /πρωί Καλημέρα! /καιρός"

#: nejomibot/specials.py
msgid ""
"Parts are separated by ; or line breaks. Text before a command heads its "
"answer, text alone is a message."
msgstr ""
"Τα μέρη χωρίζονται με ; ή αλλαγές γραμμής. Κείμενο πριν από μια εντολή "
"γίνεται τίτλος της απάντησής της· κείμενο μόνο του είναι μήνυμα."

#: nejomibot/specials.py
msgid ""
"A + in place of a ; puts the parts on either side of it in one message, as "
"in /today + /weather."
msgstr ""
"Ένα + στη θέση του ; βάζει τα μέρη και στις δύο πλευρές του σε ένα μήνυμα, "
"όπως στο /σήμερα + /καιρός."

#: nejomibot/specials.py
msgid "Text keeps the formatting you give it in Signal, such as bold."
msgstr ""
"Το κείμενο διατηρεί τη μορφοποίηση που του δίνετε στο Signal, όπως τα έντονα."

#: nejomibot/specials.py
msgid ""
"/special shortcuts <name> <names>: other names for one, such as /special "
"shortcuts /morning /gm; with -, none"
msgstr ""
"/special συντομεύσεις <όνομα> <ονόματα>: άλλα ονόματα για μία, όπως /special "
"συντομεύσεις /πρωί /gm· με -, καμία"

#: nejomibot/specials.py
msgid ""
"/special everyone <name>: everyone allowed may use it, in groups too, and /"
"help lists it; /special admins <name>: the admins alone again"
msgstr ""
"/special για όλους <όνομα>: όλοι οι επιτρεπόμενοι μπορούν να τη "
"χρησιμοποιούν, και σε ομάδες, και το /βοήθεια την αναφέρει· /special για "
"διαχειριστές <όνομα>: ξανά μόνο οι διαχειριστές"

#: nejomibot/specials.py
msgid "/special remove <name>: remove one"
msgstr "/special αφαίρεσε <όνομα>: αφαίρεση μίας"

#: nejomibot/specials.py
msgid "for everyone"
msgstr "για όλους"

#: nejomibot/specials.py
msgid "No specials of your own yet."
msgstr "Δεν υπάρχουν ακόμη δικές σας ειδικές εντολές."

#: nejomibot/specials.py
#, python-brace-format
msgid "✨ {count} special"
msgid_plural "✨ {count} specials"
msgstr[0] "✨ {count} ειδική εντολή"
msgstr[1] "✨ {count} ειδικές εντολές"

#: nejomibot/specials.py
#, python-brace-format
