#: nejomibot/timers.py
#, python-brace-format
msgid ""
"<when> is a time (08:00, or 08:00,18:30), days and a time (mon-fri 07:30, "
"sat,sun 10:00), a date and a time for once ({date} 15:00, tomorrow 08:00), "
"or every 2h or 30m"
msgstr ""
"το <πότε> είναι ώρα (08:00, ή 08:00,18:30), μέρες και ώρα (δευ-παρ 07:30, "
"σαβ,κυρ 10:00), ημερομηνία και ώρα για μία φορά ({date} 15:00, αύριο 08:00), "
"ή κάθε 2h ή 30m"

#: nejomibot/timers.py
msgid "/chats: where timers can post, numbered"
msgstr "/chats: πού μπορούν να δημοσιεύουν οι χρονοδιακόπτες, αριθμημένα"

#: nejomibot/timers.py
msgid "/timers: the timers"
msgstr "/timers: οι χρονοδιακόπτες"

#: nejomibot/timers.py
msgid "/timer add <when> [<chats>] <commands>: a new one, e.g."
msgstr "/timer πρόσθεσε <πότε> [<συνομιλίες>] <εντολές>: νέος, π.χ."

#: nejomibot/timers.py
msgid "/timer add mon-fri 07:30 1,2 /weather; /photo"
msgstr "/timer πρόσθεσε δευ-παρ 07:30 1,2 /καιρός; /φωτογραφία"

#: nejomibot/timers.py
msgid "The chats are numbers from /chats; without them, it posts to you."
msgstr ""
"Οι συνομιλίες είναι αριθμοί από το /chats· χωρίς αυτούς, δημοσιεύει σε εσάς."

#: nejomibot/timers.py
msgid "/timer remove <n>, /timer run <n>: remove one, or run it now"
msgstr ""
"/timer αφαίρεσε <n>, /timer εκτέλεσε <n>: αφαίρεση ενός, ή εκτέλεση τώρα"

#: nejomibot/timers.py
#, python-brace-format
msgid "{when_help}, in {zone} time."
msgstr "{when_help}, σε ώρα {zone}."

#: nejomibot/timers.py
msgid "Every how long? Like every 30m, every 2h or every 1h30m."
msgstr "Κάθε πόσο; Όπως κάθε 30m, κάθε 2h ή κάθε 1h30m."

#: nejomibot/timers.py
#, python-brace-format
msgid "Not more often than every {every}."
msgstr "Όχι συχνότερα από κάθε {every}."

#: nejomibot/timers.py
#, python-brace-format
msgid "There's no such day as {day}."
msgstr "Δεν υπάρχει ημέρα {day}."

#: nejomibot/timers.py
msgid "At what time?"
msgstr "Τι ώρα;"

#: nejomibot/timers.py
msgid "A timer on a date runs once: give it one time, and no days."
msgstr ""
"Ένας χρονοδιακόπτης σε ημερομηνία εκτελείται μία φορά: δώστε του μία ώρα, "
"χωρίς μέρες."

#: nejomibot/timers.py
#, python-brace-format
msgid "Timers, specials and /run can't run {command}."
msgstr ""
"Οι χρονοδιακόπτες, οι ειδικές εντολές και το /εκτέλεση δεν μπορούν να "
"εκτελέσουν το {command}."

#: nejomibot/timers.py
msgid "A timer's commands can't have a |: the timers file uses it."
msgstr ""
"Οι εντολές ενός χρονοδιακόπτη δεν μπορούν να έχουν |: το χρησιμοποιεί το "
"αρχείο των χρονοδιακοπτών."

#: nejomibot/timers.py
