msgstr "(εικονική μηχανή)"

#: nejomibot/status.py
#, python-brace-format
msgid "{cpu}, {count} CPU"
msgid_plural "{cpu}, {count} CPUs"
msgstr[0] "{cpu}, {count} CPU"
msgstr[1] "{cpu}, {count} CPU"

#: nejomibot/status.py
#, python-brace-format
