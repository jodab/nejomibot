msgstr[0] "σε {count} άλμπουμ"
msgstr[1] "σε {count} άλμπουμ"

#: nejomibot/status.py
msgid "Photo disk"
msgstr "Δίσκος φωτογραφιών"

#: nejomibot/status.py
#, python-brace-format
